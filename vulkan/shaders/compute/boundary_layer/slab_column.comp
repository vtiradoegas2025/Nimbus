#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4466], 4461, 32);
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4467], 4462, 32);
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer B0
{
    float input_values[];
};
layout(set = 0, binding = 1) writeonly buffer B1
{
    float output_values[];
};
layout(push_constant) uniform PushConstants
{
    int columns;
    int layers;
    int top_method;
    int surface_method;
    int apply_flux;
    int padding0;
    int padding1;
    int padding2;
};
#include "../microphysics/compensated_fma.glsl"
vec2 constant_value(float v)
{
    return vec2(v, 0);
}
vec2 param(int c, int f)
{
    int n = c * (46 + 14 * (layers + 1)) + 2 * f;
    return vec2(input_values[n], input_values[n + 1]);
}
vec2 state(int c, int k, int f)
{
    int n = c * (46 + 14 * (layers + 1)) + 46 + 14 * k + 2 * f;
    return vec2(input_values[n], input_values[n + 1]);
}
void put(int c, int offset, vec2 v)
{
    int n                = c * (22 + 8 * layers) + offset;
    output_values[n]     = v.x;
    output_values[n + 1] = v.y;
}
bool less_pair(vec2 a, vec2 b)
{
    return a.x < b.x || (a.x == b.x && a.y < b.y);
}
vec2 maximum(vec2 a, vec2 b)
{
    return less_pair(a, b) ? b : a;
}
vec2 minimum(vec2 a, vec2 b)
{
    return less_pair(a, b) ? a : b;
}
vec2 absolute(vec2 a)
{
    return a.x < 0 || (a.x == 0 && a.y < 0) ? -a : a;
}
vec2 root(vec2 a)
{
    return a.x == 0 && a.y == 0 ? vec2(0) : df_sqrt(a);
}
vec2 center(int c, int k)
{
    return df_mul(constant_value(.5), df_add(state(c, k, 6), state(c, k + 1, 6)));
}
vec2 virtual_theta(int c, vec2 theta, vec2 vapor)
{
    return df_mul(theta, df_add(constant_value(1), df_mul(param(c, 17), vapor)));
}
vec2 exner(int c)
{
    return df_exp(df_mul(param(c, 16), df_log(df_div(state(c, 0, 4), param(c, 15)))));
}
vec2 bounded(int c, vec2 h)
{
    return maximum(param(c, 0), minimum(param(c, 1), h));
}
vec2 height(int c)
{
    if (layers < 2)
        return param(c, 0);
    if (top_method == 1)
    {
        vec2 lowest   = state(c, 0, 0);
        int  lowest_k = 0;
        for (int k = 1; k < layers; ++k)
        {
            if (less_pair(param(c, 22), center(c, k)))
                break;
            if (less_pair(state(c, k, 0), lowest))
            {
                lowest   = state(c, k, 0);
                lowest_k = k;
            }
        }
        vec2 prior = vec2(0), z_prior = center(c, lowest_k);
        for (int k = lowest_k + 1; k < layers; ++k)
        {
            vec2 excess = df_sub(state(c, k, 0), lowest), z = center(c, k);
            if (!less_pair(excess, param(c, 19)))
            {
                vec2 fraction = constant_value(1);
                if (less_pair(prior, excess))
                    fraction =
                        maximum(vec2(0),
                                minimum(constant_value(1), df_div(df_sub(param(c, 19), prior), df_sub(excess, prior))));
                return bounded(c, df_add(z_prior, df_mul(fraction, df_sub(z, z_prior))));
            }
            prior   = excess;
            z_prior = z;
        }
    }
    else
    {
        vec2 theta0 = virtual_theta(c, state(c, 0, 0), state(c, 0, 1)), z0 = center(c, 0), previous = vec2(0),
             z_previous = z0;
        for (int k = 1; k < layers; ++k)
        {
            vec2 z = center(c, k), theta = virtual_theta(c, state(c, k, 0), state(c, k, 1));
            vec2 du = df_sub(state(c, k, 2), state(c, 0, 2)), dv = df_sub(state(c, k, 3), state(c, 0, 3));
            vec2 shear = maximum(df_add(df_mul(du, du), df_mul(dv, dv)), param(c, 20));
            vec2 ri = df_div(df_mul(df_mul(param(c, 13), df_sub(theta, theta0)), df_sub(z, z0)), df_mul(theta0, shear));
            if (any(isnan(ri)) || any(isinf(ri)))
                return vec2(uintBitsToFloat(0x7fc00000u));
            if (!less_pair(ri, constant_value(.25)))
            {
                vec2 h = z;
                if (less_pair(previous, ri))
                    h = df_add(z_previous,
                               df_div(df_mul(df_sub(z, z_previous), df_sub(constant_value(.25), previous)),
                                      df_sub(ri, previous)));
                return bounded(c, h);
            }
            previous   = ri;
            z_previous = z;
        }
    }
    return param(c, 1);
}
vec2 atan_positive(int c, vec2 value)
{
    bool inverse = less_pair(constant_value(1), value);
    vec2 x       = inverse ? df_div(constant_value(1), value) : value;
    bool reduce  = x.x > .41421356;
    if (reduce)
        x = df_div(df_sub(x, constant_value(1)), df_add(x, constant_value(1)));
    vec2 term = x, sum = x, square = df_mul(x, x);
    for (int k = 1; k < 32; ++k)
    {
        term = -df_mul(term, square);
        sum  = df_add(sum, df_div(term, constant_value(float(2 * k + 1))));
    }
    if (reduce)
        sum = df_add(df_mul(param(c, 21), constant_value(.25)), sum);
    return inverse ? df_sub(df_mul(param(c, 21), constant_value(.5)), sum) : sum;
}
vec2 psi(int c, vec2 zeta, bool momentum)
{
    if (!less_pair(zeta, vec2(0)))
    {
        vec2 value = -df_mul(constant_value(5), zeta);
        if (momentum)
            value = df_sub(value,
                           df_div(df_mul(df_mul(constant_value(5), zeta), zeta),
                                  df_add(constant_value(1), df_mul(constant_value(5), zeta))));
        return value;
    }
    vec2 x = root(root(df_sub(constant_value(1), df_mul(constant_value(16), zeta)))), xx = df_mul(x, x);
    if (!momentum)
        return df_mul(constant_value(2), df_log(df_mul(constant_value(.5), df_add(constant_value(1), xx))));
    vec2 result = df_add(df_mul(constant_value(2), df_log(df_mul(constant_value(.5), df_add(constant_value(1), x)))),
                         df_log(df_mul(constant_value(.5), df_add(constant_value(1), xx))));
    return df_add(df_sub(result, df_mul(constant_value(2), atan_positive(c, x))),
                  df_mul(param(c, 21), constant_value(.5)));
}
vec2 louis(vec2 ri, vec2 z_ratio, vec2 neutral, float numerator)
{
    if (!less_pair(ri, vec2(0)))
        return df_div(constant_value(1),
                      df_add(constant_value(1),
                             df_div(df_mul(constant_value(numerator), ri),
                                    root(df_add(constant_value(1), df_mul(constant_value(5), ri))))));
    vec2 denominator =
        df_add(constant_value(1), df_mul(df_mul(constant_value(75), neutral), root(df_mul(z_ratio, -ri))));
    return df_sub(constant_value(1), df_div(df_mul(constant_value(numerator), ri), denominator));
}
bool surface(
    int c, out vec2 ustar, out vec2 tau_u, out vec2 tau_v, out vec2 heat, out vec2 vapor, out vec2 cd, out vec2 ch)
{
    ustar = tau_u = tau_v = heat = vapor = cd = ch = vec2(0);
    if (apply_flux == 0)
        return true;
    vec2 hx = param(c, 7), hy = param(c, 8), one = constant_value(1);
    vec2 l11 = root(df_add(one, df_mul(hx, hx))), l12 = df_div(df_mul(hx, hy), l11);
    vec2 l22  = root(df_sub(df_add(one, df_mul(hy, hy)), df_mul(l12, l12)));
    vec2 area = root(df_add(df_add(one, df_mul(hx, hx)), df_mul(hy, hy)));
    vec2 u = df_add(df_mul(l11, param(c, 2)), df_mul(l12, param(c, 3))), v = df_mul(l22, param(c, 3));
    vec2 speed = maximum(root(df_add(df_mul(u, u), df_mul(v, v))), constant_value(.1));
    vec2 air = virtual_theta(c, state(c, 0, 0), state(c, 0, 1)), skin = virtual_theta(c, param(c, 4), param(c, 5));
    vec2 log_m = df_log(df_div(param(c, 6), param(c, 9))), log_h = df_log(df_div(param(c, 6), param(c, 10)));
    vec2 length = constant_value(1e6), last_length = length, pi = exner(c);
    bool converged = surface_method == 0;
    for (int iteration = 0; iteration < (surface_method == 0 ? 1 : 50); ++iteration)
    {
        vec2 dm = log_m, dh = log_h;
        if (surface_method != 0)
        {
            vec2 zeta = df_div(param(c, 6), length);
            dm        = df_sub(dm, psi(c, zeta, true));
            dh        = df_sub(dh, psi(c, zeta, false));
        }
        if (abs(dm.x) < 1e-6 || abs(dh.x) < 1e-6)
            return false;
        vec2 ratio = df_div(param(c, 12), dm);
        cd         = df_mul(ratio, ratio);
        ch         = df_div(df_mul(param(c, 12), param(c, 12)), df_mul(dm, dh));
        if (surface_method == 0)
        {
            vec2 ri =
                df_div(df_mul(df_mul(param(c, 13), df_sub(air, skin)), param(c, 6)), df_mul(air, df_mul(speed, speed)));
            vec2 zr = df_div(param(c, 6), param(c, 9));
            vec2 fm = louis(ri, zr, cd, 10), fh = louis(ri, zr, ch, 15);
            cd = df_mul(cd, fm);
            ch = df_mul(ch, fh);
        }
        if (less_pair(cd, vec2(0)) || less_pair(ch, vec2(0)))
            return false;
        ustar = df_mul(root(cd), speed);
        if (less_pair(ustar, param(c, 11)))
        {
            vec2 ratio_min = df_div(param(c, 11), speed), required = df_mul(ratio_min, ratio_min),
                 floor_cd = maximum(cd, constant_value(1e-12));
            if (less_pair(floor_cd, required))
            {
                ch = df_mul(ch, df_div(required, floor_cd));
                cd = required;
            }
            ustar = param(c, 11);
        }
        heat  = df_mul(df_mul(df_mul(df_mul(df_mul(state(c, 0, 5), param(c, 14)), pi), ch), speed),
                       df_sub(param(c, 4), state(c, 0, 0)));
        vapor = df_mul(df_mul(df_mul(state(c, 0, 5), ch), speed), df_sub(param(c, 5), state(c, 0, 1)));
        if (surface_method != 0)
        {
            vec2 wt  = df_div(heat, df_mul(df_mul(state(c, 0, 5), param(c, 14)), pi)),
                 wq  = df_div(vapor, state(c, 0, 5));
            vec2 wtv = df_add(wt, df_mul(df_mul(param(c, 17), state(c, 0, 0)), wq));
            length   = abs(wtv.x) > 1e-10 ? -df_div(df_mul(df_mul(df_mul(ustar, ustar), ustar), air),
                                                    df_mul(df_mul(param(c, 12), param(c, 13)), wtv))
                                          : constant_value(1e6);
            vec2 change =
                df_div(absolute(df_sub(length, last_length)), maximum(absolute(last_length), constant_value(1e-6)));
            if (change.x < 1e-3)
            {
                converged = true;
                break;
            }
            last_length = length;
        }
    }
    if (!converged)
        return false;
    vec2 stress = -df_mul(df_mul(state(c, 0, 5), cd), speed), tu = df_mul(stress, u), tv = df_mul(stress, v);
    tau_u = df_mul(df_mul(area, l11), tu);
    tau_v = df_mul(area, df_add(df_mul(l12, tu), df_mul(l22, tv)));
    heat  = df_mul(area, heat);
    vapor = df_mul(area, vapor);
    return true;
}
void evaluate(uint gid)
{
    if (gid >= uint(columns))
        return;
    int c = int(gid);
    for (int offset = 0; offset < 22 + 8 * layers; offset += 2)
        put(c, offset, vec2(0));
    vec2 h = height(c), mass = vec2(0), u_inventory = vec2(0), v_inventory = vec2(0), heat_inventory = vec2(0),
         vapor_inventory = vec2(0);
    int  active_levels          = 0;
    for (int k = 0; k < layers; ++k)
    {
        vec2 overlap = maximum(constant_value(0), df_sub(minimum(h, state(c, k + 1, 6)), state(c, k, 6)));
        if (!less_pair(constant_value(0), overlap))
            break;
        vec2 m          = df_mul(state(c, k, 5), overlap);
        mass            = df_add(mass, m);
        u_inventory     = df_add(u_inventory, df_mul(m, state(c, k, 2)));
        v_inventory     = df_add(v_inventory, df_mul(m, state(c, k, 3)));
        heat_inventory  = df_add(heat_inventory, df_mul(m, state(c, k, 0)));
        vapor_inventory = df_add(vapor_inventory, df_mul(m, state(c, k, 1)));
        ++active_levels;
    }
    vec2 ustar, tu, tv, heat, vapor, cd, ch;
    if (active_levels == 0 || mass.x <= 0 || !surface(c, ustar, tu, tv, heat, vapor, cd, ch))
    {
        put(c, 0, vec2(uintBitsToFloat(0x7fc00000u)));
        return;
    }
    vec2 um = df_div(u_inventory, mass), vm = df_div(v_inventory, mass), tm = df_div(heat_inventory, mass),
         qm = df_div(vapor_inventory, mass);
    put(c, 0, h);
    put(c, 2, tm);
    put(c, 4, qm);
    put(c, 6, ustar);
    put(c, 8, tu);
    put(c, 10, tv);
    put(c, 12, heat);
    put(c, 14, vapor);
    put(c, 16, cd);
    put(c, 18, ch);
    put(c, 20, ch);
    vec2 theta_flux = df_div(heat, df_mul(param(c, 14), exner(c)));
    vec2 sum_u = vec2(0), sum_v = vec2(0), sum_t = vec2(0), sum_q = vec2(0);
    for (int k = 0; k < active_levels; ++k)
    {
        vec2 m = df_mul(state(c, k, 5), df_sub(state(c, k + 1, 6), state(c, k, 6))), du, dv, dt, dq;
        if (k == active_levels - 1)
        {
            du = df_div(df_sub(tu, sum_u), m);
            dv = df_div(df_sub(tv, sum_v), m);
            dt = df_div(df_sub(theta_flux, sum_t), m);
            dq = df_div(df_sub(vapor, sum_q), m);
        }
        else
        {
            du    = df_add(df_mul(param(c, 18), df_sub(um, state(c, k, 2))), df_div(tu, mass));
            dv    = df_add(df_mul(param(c, 18), df_sub(vm, state(c, k, 3))), df_div(tv, mass));
            dt    = df_add(df_mul(param(c, 18), df_sub(tm, state(c, k, 0))), df_div(theta_flux, mass));
            dq    = df_add(df_mul(param(c, 18), df_sub(qm, state(c, k, 1))), df_div(vapor, mass));
            sum_u = df_add(sum_u, df_mul(m, du));
            sum_v = df_add(sum_v, df_mul(m, dv));
            sum_t = df_add(sum_t, df_mul(m, dt));
            sum_q = df_add(sum_q, df_mul(m, dq));
        }
        put(c, 22 + 8 * k, du);
        put(c, 24 + 8 * k, dv);
        put(c, 26 + 8 * k, dt);
        put(c, 28 + 8 * k, dq);
    }
}
void main()
{
    evaluate(gl_GlobalInvocationID.x);
}
