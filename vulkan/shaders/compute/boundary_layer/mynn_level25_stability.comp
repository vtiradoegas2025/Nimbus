// Nakanishi--Niino (2009) level-2.5 stability functions.
// Independent pointwise translation of tmv::mynn::level25_stability_functions.

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer GmBuf { float gm_s2[]; };
layout(set = 0, binding = 1) readonly buffer GhBuf { float gh_s2[]; };
layout(set = 0, binding = 2) readonly buffer LBuf  { float mixing_length_m[]; };
layout(set = 0, binding = 3) readonly buffer QBuf  { float q_squared_m2s2[]; };
layout(set = 0, binding = 4) writeonly buffer SmBuf { float sm[]; };
layout(set = 0, binding = 5) writeonly buffer ShBuf { float sh[]; };
layout(set = 0, binding = 6) writeonly buffer RiBuf { float gradient_richardson[]; };
layout(set = 0, binding = 7) writeonly buffer RfBuf { float flux_richardson[]; };
layout(set = 0, binding = 8) writeonly buffer QdivBuf { float equilibrium_limiter[]; };

layout(push_constant) uniform PushConstants {
    int count;
    int padding0;
    int padding1;
    int padding2;
};

bool finite_f(float value) { return !isnan(value) && !isinf(value); }

void fail(uint gid)
{
    const float invalid = uintBitsToFloat(0x7fc00000u);
    sm[gid] = invalid;
    sh[gid] = invalid;
    gradient_richardson[gid] = invalid;
    flux_richardson[gid] = invalid;
    equilibrium_limiter[gid] = invalid;
}

void main()
{
    const uint gid = gl_GlobalInvocationID.x;
    if (gid >= uint(count)) return;

    const float gm = gm_s2[gid];
    const float gh = gh_s2[gid];
    const float length = mixing_length_m[gid];
    const float q2 = q_squared_m2s2[gid];
    if (!finite_f(gm) || gm < 0.0 || !finite_f(gh) ||
        !finite_f(length) || length <= 0.0 || !finite_f(q2) || q2 <= 0.0)
    {
        fail(gid);
        return;
    }

    const float g1 = 0.235;
    const float b1 = 24.0;
    const float b2 = 15.0;
    const float c2 = 0.75;
    const float c3 = 0.352;
    const float c5 = 0.2;
    const float pr = 0.74;
    const float a1 = b1 * (1.0 - 3.0 * g1) / 6.0;
    const float c1 = g1 - 1.0 / (3.0 * a1 * pow(b1, 1.0 / 3.0));
    const float a2 = a1 * (g1 - c1) / (g1 * pr);
    const float g2 = b2 / b1 * (1.0 - c3) + 2.0 * a1 / b1 * (3.0 - 2.0 * c2);
    const float rfc = g1 / (g1 + g2);
    const float f1 = b1 * (g1 - c1) + 3.0 * a2 * (1.0 - c2) * (1.0 - c5)
                   + 2.0 * a1 * (3.0 - 2.0 * c2);
    const float f2 = b1 * (g1 + g2) - 3.0 * a1 * (1.0 - c2);
    const float rf1 = b1 * (g1 - c1) / f1;
    const float rf2 = b1 * g1 / f2;
    const float smc = a1 / a2 * f1 / f2;
    const float shc = 3.0 * a2 * (g1 + g2);
    const float ri1 = 0.5 / smc;
    const float ri2 = rf1 * smc;
    const float ri3 = 4.0 * rf2 * smc - 2.0 * ri2;
    const float ri4 = ri2 * ri2;

    const float ri = -gh / max(gm, 1.0e-10);
    const float discriminant = max(0.0, ri * ri - ri3 * ri + ri4);
    const float rf = min(ri1 * (ri + ri2 - sqrt(discriminant)), rfc);
    float sh_value = shc * (rfc - rf) / (1.0 - rf);
    float sm_value = smc * (rf1 - rf) / (rf2 - rf) * sh_value;

    const float length2 = length * length;
    const float equilibrium_q2 = b1 * length2 * (sm_value * gm + sh_value * gh);
    float qdiv = 1.0;
    if (equilibrium_q2 > 0.0 && q2 < equilibrium_q2)
    {
        qdiv = sqrt(q2 / equilibrium_q2);
        sm_value *= qdiv;
        sh_value *= qdiv;
    }
    else
    {
        const float e5c = 6.0 * a1 * a1;
        const float e1c = 3.0 * a2 * b2 * (1.0 - c3);
        const float e2c = 9.0 * a1 * a2 * (1.0 - c2);
        const float e3c = 9.0 * a2 * a2 * (1.0 - c2) * (1.0 - c5);
        const float e4c = 12.0 * a1 * a2 * (1.0 - c2);
        const float gmel = gm * length2;
        const float ghel = gh * length2;
        const float e1 = q2 - e1c * ghel;
        const float e2 = q2 - e2c * ghel;
        const float e3 = e1 + e3c * ghel;
        const float e4 = e1 - e4c * ghel;
        const float denominator = e2 * e4 + e3 * e5c * gmel;
        if (!finite_f(denominator) || denominator <= 1.0e-20)
        {
            fail(gid);
            return;
        }
        sm_value = q2 * a1 * (e3 - 3.0 * c1 * e4) / denominator;
        sh_value = q2 * a2 * (e2 + 3.0 * c1 * e5c * gmel) / denominator;
    }

    if (!finite_f(sm_value) || !finite_f(sh_value) || sm_value < 0.0 || sh_value < 0.0)
    {
        fail(gid);
        return;
    }
    sm[gid] = sm_value;
    sh[gid] = sh_value;
    gradient_richardson[gid] = ri;
    flux_richardson[gid] = rf;
    equilibrium_limiter[gid] = qdiv;
}
