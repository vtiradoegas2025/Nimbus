// advect_pd_limiter_cartesian_cgrid.comp
//
// Positive-definite flux renormalization (SCIENCE.md M5;
// Skamarock & Weisman 2006) for the conservative C-grid scalar transport:
// per cell, the factor by which its OUTGOING scalar fluxes must be scaled
// so one step cannot remove more scalar mass than the cell holds:
//   r = min(1, (rho * max(q, 0) / dt) / sum(outgoing flux / dx)).
// The update pass then scales each face flux by its DONOR cell's r.
// Exactly conservative (fluxes rescaled, never clipped); inactive on a
// uniform positive field below CFL 1, so free-stream preservation is
// untouched. Outgoing-ness is by FLUX SIGN, so negative reconstructed
// face values are charged to the correct donor. GPU equivalent of the
// r_lim pass in advect_scalar_conservative_3d_cartesian.
//
// Face storage matches the flux pass: the flux through face i+1/2 lives
// at index i ("owning cell" slot).
//
// Data layout: row-major [nx][ny][nz]. Index (i, j, k) = (i*ny + j)*nz + k.

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer QBuf   { float q_in[];   };
layout(set = 0, binding = 1) readonly buffer RhoBuf { float rho_in[]; };
layout(set = 0, binding = 2) readonly buffer SfxBuf { float sfx[];    };
layout(set = 0, binding = 3) readonly buffer SfyBuf { float sfy[];    };
layout(set = 0, binding = 4) readonly buffer SfzBuf { float sfz[];    };

layout(set = 0, binding = 5) writeonly buffer RBuf { float r_out[]; };

// In coupled mode these are the time-averaged mass fluxes produced by the
// acoustic loop.  Standalone mode binds its ordinary mass-flux buffers and
// leaves use_coupled_mass == 0, so its historical budget is unchanged.
layout(set = 0, binding = 6) readonly buffer MfxBuf { float mfx[]; };
layout(set = 0, binding = 7) readonly buffer MfyBuf { float mfy[]; };
layout(set = 0, binding = 8) readonly buffer MfzBuf { float mfz[]; };
layout(set = 0, binding = 9) readonly buffer RhoBeginBuf {
    float rho_begin[];
};

// Push constants (32 bytes; mirrors AdvectPdLimiterPushConstants).
layout(push_constant) uniform PushConstants {
    int   nx;
    int   ny;
    int   nz;
    int   use_coupled_mass;
    float inv_dx;
    float inv_dy;
    float inv_dz;
    float dt_step;
};

// An active limiter is an upper bound on outgoing scalar mass. The update
// evaluates at most six scaled face terms plus their products, ordered sum,
// and final timestep multiplication. Standard gamma_n accounting bounds that
// FP32 chain below 32*epsilon. Reserve that relative amount in the shared face
// flux, then decrement once so rounding cannot move the factor above the
// bound. Inactive r=1 transport remains bit-for-bit unchanged.
float conservative_limiter_factor(float r, bool support_limit)
{
    if (r > 0.0 && (r < 1.0 || support_limit))
    {
        const float roundoff_factor =
            1.0 - 32.0 * 1.1920928955078125e-7;
        float bounded = r * roundoff_factor;
        if (bounded > 0.0)
            bounded = uintBitsToFloat(floatBitsToUint(bounded) - 1u);
        return bounded;
    }
    return r;
}

void main()
{
    uint gid = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    uint total = uint(nx) * uint(ny) * uint(nz);
    if (gid >= total)
    {
        return;
    }

    int k = int(gid % uint(nz));
    uint ij = gid / uint(nz);
    int j = int(ij % uint(ny));
    int i = int(ij / uint(ny));
    uint c = gid;

    float out_rate = 0.0;
    // +x face (stored at c, exists for i <= nx-2); -x face at (i-1) is
    // outgoing from this cell when its flux is negative.
    if (i <= nx - 2 && sfx[c] > 0.0)
    {
        out_rate += sfx[c] * inv_dx;
    }
    if (i >= 1)
    {
        float f = sfx[uint(((i - 1) * ny + j) * nz + k)];
        if (f < 0.0) { out_rate -= f * inv_dx; }
    }
    if (j <= ny - 2 && sfy[c] > 0.0)
    {
        out_rate += sfy[c] * inv_dy;
    }
    if (j >= 1)
    {
        float f = sfy[uint((i * ny + (j - 1)) * nz + k)];
        if (f < 0.0) { out_rate -= f * inv_dy; }
    }
    if (sfz[c] > 0.0)
    {
        out_rate += sfz[c] * inv_dz;
    }
    if (k >= 1)
    {
        float f = sfz[uint((i * ny + j) * nz + (k - 1))];
        if (f < 0.0) { out_rate -= f * inv_dz; }
    }

    float r = 1.0;
    if (out_rate > 0.0)
    {
        // Coupled transport retains the actual pre-continuity density. Using
        // it directly avoids a second, roundoff-sensitive density evolution.
        float rho_available = ((use_coupled_mass & 1) != 0)
            ? rho_begin[c] : rho_in[c];
        float available = rho_available * max(q_in[c], 0.0) / dt_step;
        r = min(1.0, available / out_rate);
        r = conservative_limiter_factor(r, (use_coupled_mass & 2) != 0 && available <= out_rate);
    }
    r_out[c] = r;
}
