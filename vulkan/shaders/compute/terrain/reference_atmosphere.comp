#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4466], 4461, 32);
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4467], 4462, 32);
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer B0
{
    float input_values[];
};
layout(set = 0, binding = 1) writeonly buffer B1
{
    float output_values[];
};
layout(push_constant) uniform PushConstants
{
    int   count;
    int   levels;
    float dz_high;
    float dz_low;
    float rd_high;
    float rd_low;
    float p0_high;
    float p0_low;
    float kappa_high;
    float kappa_low;
    int   theta_exponent;
    int   pressure_exponent;
    int   vapor_exponent;
    int   u_exponent;
    int   v_exponent;
    int   padding;
};
#include "../microphysics/compensated_fma.glsl"
#include "compensated_storage.glsl"
float store_scaled(vec2 value, int exponent)
{
    if (any(isnan(value)) || any(isinf(value)))
        return uintBitsToFloat(0x7fc00000u);
    if (abs(value.x) >= ldexp(1.0, -125 - exponent))
        return ldexp(value.y == 0 ? value.x : fma(1.0, value.x, value.y), exponent);
    uint sign  = floatBitsToUint(value.x) & 0x80000000u;
    vec2 units = df_mul(sign == 0u ? value : -value, vec2(ldexp(1.0, exponent + 149), 0));
    // Apply very small exponents in two steps to keep the scaling factor representable.
    if (exponent + 149 < -126)
        units =
            df_mul(df_mul(sign == 0u ? value : -value, vec2(ldexp(1.0, exponent + 275), 0)), vec2(ldexp(1.0, -126), 0));
    return round_storage_units(units, sign);
}
vec2 profile(int k, int f)
{
    return vec2(input_values[10 * k + 2 * f], input_values[10 * k + 2 * f + 1]);
}
float sample_value(int f, int exponent, int lower, vec2 weight)
{
    vec2 value = profile(lower, f);
    if (levels > 1)
        value = df_add(value, df_mul(weight, df_sub(profile(lower + 1, f), value)));
    return store_scaled(value, exponent);
}
void evaluate(uint gid)
{
    if (gid >= uint(count))
        return;
    int  n          = int(gid);
    vec2 height     = vec2(input_values[10 * levels + 2 * n], input_values[10 * levels + 2 * n + 1]);
    vec2 fractional = df_sub(df_div(height, vec2(dz_high, dz_low)), vec2(0.5, 0));
    if (any(isnan(fractional)) || any(isinf(fractional)))
    {
        for (int f = 0; f < 6; ++f)
            output_values[6 * n + f] = uintBitsToFloat(0x7fc00000u);
        return;
    }
    float integral = floor(fractional.x);
    if (integral == fractional.x && fractional.y < 0)
        integral -= 1;
    int   lower    = levels == 1 ? 0 : int(clamp(integral, 0.0, float(levels - 2)));
    vec2  weight   = df_sub(fractional, vec2(float(lower), 0));
    float theta    = sample_value(0, theta_exponent, lower, weight);
    float pressure = sample_value(1, pressure_exponent, lower, weight);
    float vapor    = sample_value(2, vapor_exponent, lower, weight);
    float u        = sample_value(3, u_exponent, lower, weight);
    float v        = sample_value(4, v_exponent, lower, weight);
    vec2  temperature =
        df_mul(vec2(theta, 0),
               df_exp(df_mul(vec2(kappa_high, kappa_low), df_log(df_div(vec2(pressure, 0), vec2(p0_high, p0_low))))));
    vec2 rho                 = df_div(vec2(pressure, 0), df_mul(vec2(rd_high, rd_low), temperature));
    output_values[6 * n]     = theta;
    output_values[6 * n + 1] = pressure;
    output_values[6 * n + 2] = vapor;
    output_values[6 * n + 3] = u;
    output_values[6 * n + 4] = v;
    output_values[6 * n + 5] = rho.y == 0 ? rho.x : fma(1.0, rho.x, rho.y);
}
void main()
{
    evaluate(gl_GlobalInvocationID.x);
}
