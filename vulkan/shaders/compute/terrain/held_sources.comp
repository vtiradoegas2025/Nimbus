#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4466], 4461, 32);
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4467], 4462, 32);
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer B0
{
    float input_values[];
};
layout(set = 0, binding = 1) writeonly buffer B1
{
    float output_values[];
};
layout(push_constant) uniform PushConstants
{
    int   nx;
    int   ny;
    int   nz;
    int   i_begin;
    int   i_end;
    int   j_begin;
    int   j_end;
    int   k_begin;
    int   k_end;
    int   staggered;
    int   periodic_x;
    int   periodic_y;
    int   pbl_enabled;
    int   radiation_enabled;
    int   cloud_enabled;
    float cp_high;
    float cp_low;
    float p0_high;
    float p0_low;
    float kappa_high;
    float kappa_low;
};
#include "../microphysics/compensated_fma.glsl"
#include "compensated_storage.glsl"
float store_scaled(vec2 value, int exponent)
{
    if (any(isnan(value)) || any(isinf(value)))
        return uintBitsToFloat(0x7fc00000u);
    if (abs(value.x) >= ldexp(1.0, -125 - exponent))
        return ldexp(value.y == 0 ? value.x : fma(1.0, value.x, value.y), exponent);
    uint sign  = floatBitsToUint(value.x) & 0x80000000u;
    vec2 units = df_mul(sign == 0u ? value : -value, vec2(ldexp(1.0, exponent + 149), 0));
    // Apply very small exponents in two steps to keep the scaling factor representable.
    if (exponent + 149 < -126)
        units =
            df_mul(df_mul(sign == 0u ? value : -value, vec2(ldexp(1.0, exponent + 275), 0)), vec2(ldexp(1.0, -126), 0));
    return round_storage_units(units, sign);
}
vec2 mass(int n)
{
    return df_mul(vec2(input_values[11 * n], 0), vec2(input_values[11 * n + 2], input_values[11 * n + 3]));
}
int source_exponent(int n, int field)
{
    uint bits = floatBitsToUint(input_values[11 * n + 4 + field]) & 0x7fffffffu;
    uint encoded = bits >> 23u;
    if (encoded != 0u)
        return int(encoded) - 126;
    if (bits == 0u)
        return -149;
    int exponent = -148;
    while (bits > 1u)
    {
        bits >>= 1u;
        ++exponent;
    }
    return exponent;
}
vec2 source(int n, int field, int exponent)
{
    uint bits = floatBitsToUint(input_values[11 * n + 4 + field]);
    uint magnitude = bits & 0x7fffffffu;
    if (magnitude == 0u)
        return vec2(0);
    int own_exponent = source_exponent(n, field);
    int shift = own_exponent - exponent;
    // Two operands this far apart cannot cancel; the smaller one is below pair precision.
    if (shift < -120)
        return vec2(0);
    float mantissa;
    if ((magnitude >> 23u) == 0u)
    {
        mantissa = ldexp(float(magnitude), -own_exponent - 149);
        if ((bits & 0x80000000u) != 0u)
            mantissa = -mantissa;
    }
    else
        mantissa = uintBitsToFloat((bits & 0x807fffffu) | 0x3f000000u);
    return vec2(ldexp(mantissa, shift), 0);
}
vec2 normalized_source(int n, int field)
{
    return source(n, field, source_exponent(n, field));
}
void evaluate(uint gid)
{
    if (gid >= uint(nx) * uint(ny) * uint(nz))
        return;
    int n = int(gid), i = n / (ny * nz), j = (n / nz) % ny, k = n % nz;
    for (int f = 0; f < 7; ++f)
        output_values[7 * n + f] = 0;
    bool scalar_owned = i >= i_begin && i < i_end && j >= j_begin && j < j_end && k >= k_begin && k < k_end;
    if (pbl_enabled != 0 && scalar_owned)
    {
        vec2 m                   = mass(n);
        output_values[7 * n + 2] = store_scaled(df_div(normalized_source(n, 2), m), source_exponent(n, 2));
        output_values[7 * n + 3] = store_scaled(df_div(normalized_source(n, 3), m), source_exponent(n, 3));
        if (cloud_enabled != 0)
        {
            output_values[7 * n + 4] = store_scaled(df_div(normalized_source(n, 4), m), source_exponent(n, 4));
            output_values[7 * n + 5] = store_scaled(df_div(normalized_source(n, 5), m), source_exponent(n, 5));
        }
        if (staggered == 0)
        {
            output_values[7 * n]     = store_scaled(df_div(normalized_source(n, 0), m), source_exponent(n, 0));
            output_values[7 * n + 1] = store_scaled(df_div(normalized_source(n, 1), m), source_exponent(n, 1));
        }
        else
        {
            if (nx >= 3 && i < (periodic_x != 0 ? i_end : i_end - 1))
            {
                int right = ((i + 1 < i_end ? i + 1 : i_begin) * ny + j) * nz + k;
                int exponent = max(source_exponent(n, 0), source_exponent(right, 0));
                output_values[7 * n] = store_scaled(
                    df_div(df_add(source(n, 0, exponent), source(right, 0, exponent)), df_add(m, mass(right))), exponent);
            }
            if (ny >= 3 && j < (periodic_y != 0 ? j_end : j_end - 1))
            {
                int north = (i * ny + (j + 1 < j_end ? j + 1 : j_begin)) * nz + k;
                int exponent = max(source_exponent(n, 1), source_exponent(north, 1));
                output_values[7 * n + 1] = store_scaled(
                    df_div(df_add(source(n, 1, exponent), source(north, 1, exponent)), df_add(m, mass(north))), exponent);
            }
        }
    }
    if (radiation_enabled != 0)
    {
        vec2 pi          = df_exp(df_mul(vec2(kappa_high, kappa_low),
                                         df_log(df_div(vec2(input_values[11 * n + 1], 0), vec2(p0_high, p0_low)))));
        vec2 denominator = df_mul(df_mul(mass(n), vec2(cp_high, cp_low)), pi);
        output_values[7 * n + 6] = store_scaled(df_div(normalized_source(n, 6), denominator), source_exponent(n, 6));
    }
}
void main()
{
    evaluate(gl_GlobalInvocationID.x);
}
