// acoustic_pressure_cartesian.comp
//
// Fused acoustic pressure substep for Cartesian grids: divergence -> rho/p integration.
//
// GPU equivalent of compute_fast_pressure_tendencies + integration for Cartesian
// coordinate systems. Uses simple Cartesian divergence (du/dx + dv/dy + dw/dz)
// with no geometric curvature terms.
//
// Boundary handling: all 6 faces get zero-gradient rho, hydrostatic p at z-faces.
// Interior-only stencil: centered finite differences on (i,j,k) with i,j non-periodic.
//
// Data layout is row-major [nx][ny][nz].

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Input state (read-only for this substep)
layout(set = 0, binding = 0) readonly buffer UInBuf   { float u_in[];   };
layout(set = 0, binding = 1) readonly buffer VInBuf   { float v_in[];   };
layout(set = 0, binding = 2) readonly buffer WInBuf   { float w_in[];   };
layout(set = 0, binding = 3) readonly buffer RhoInBuf { float rho_in[]; };
layout(set = 0, binding = 4) readonly buffer PInBuf   { float p_in[];   };

// Output state (updated rho, p after integration)
layout(set = 0, binding = 5) writeonly buffer RhoOutBuf { float rho_out[]; };
layout(set = 0, binding = 6) writeonly buffer POutBuf   { float p_out[];   };

// Push constants (40 bytes, same struct as cylindrical variant)
layout(push_constant) uniform PushConstants {
    int   nr;          // nx
    int   nth;         // ny
    int   nz;
    float dr;          // dx
    float dtheta;      // dy
    float dz_val;
    float gamma_val;
    float dt_small;
    float rho_floor;
    float p_floor;
};

const float RHO_MIN = 1.0e-6;
const float GRAVITY = 9.81;

float sanitize(float val) {
    return (isnan(val) || isinf(val)) ? 0.0 : val;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint total = uint(nr) * uint(nth) * uint(nz);
    if (gid >= total) return;

    int k = int(gid % uint(nz));
    uint ij = gid / uint(nz);
    int j = int(ij % uint(nth));
    int i = int(ij / uint(nth));

    uint c = gid;

    bool is_x_boundary = (i == 0 || i == nr - 1);
    bool is_y_boundary = (j == 0 || j == nth - 1);
    bool is_z_boundary = (k == 0 || k == nz - 1);
    bool is_boundary = is_x_boundary || is_y_boundary || is_z_boundary;

    if (is_boundary) {
        int i_src = clamp(i, 1, nr - 2);
        int j_src = clamp(j, 1, nth - 2);
        int k_src = clamp(k, 1, nz - 2);
        uint src_idx = uint((i_src * nth + j_src) * nz + k_src);
        float rho_src = rho_in[src_idx];
        rho_out[c] = rho_src;

        if (is_z_boundary && !is_x_boundary && !is_y_boundary) {
            // Hydrostatic pressure extrapolation at z-faces
            float rho_safe = max(rho_src, 1.0e-3);
            float sign = (k == 0) ? 1.0 : -1.0;
            p_out[c] = p_in[src_idx] + sign * rho_safe * GRAVITY * dz_val;
        } else {
            p_out[c] = p_in[src_idx];
        }
        return;
    }

    // Interior: Cartesian divergence du/dx + dv/dy + dw/dz
    uint ip = uint(((i + 1) * nth + j) * nz + k);
    uint im = uint(((i - 1) * nth + j) * nz + k);
    uint jp = uint((i * nth + (j + 1)) * nz + k);
    uint jm = uint((i * nth + (j - 1)) * nz + k);
    uint kp = uint((i * nth + j) * nz + (k + 1));
    uint km = uint((i * nth + j) * nz + (k - 1));

    float inv_2dx = 1.0 / (2.0 * dr);
    float inv_2dy = 1.0 / (2.0 * dtheta);
    float inv_2dz = 1.0 / (2.0 * dz_val);

    float du_dx = (u_in[ip] - u_in[im]) * inv_2dx;
    float dv_dy = (v_in[jp] - v_in[jm]) * inv_2dy;
    float dw_dz = (w_in[kp] - w_in[km]) * inv_2dz;

    float divergence = du_dx + dv_dy + dw_dz;

    float rho_val = rho_in[c];
    float p_val   = p_in[c];
    float rho_safe = (rho_val > RHO_MIN && !isinf(rho_val)) ? rho_val : 1.0;

    float drho = sanitize(-rho_safe * divergence);
    float dp   = sanitize(-gamma_val * p_val * divergence);

    float rho_new = rho_val + drho * dt_small;
    if (isnan(rho_new) || isinf(rho_new) || rho_new <= 0.0)
        rho_new = rho_floor;
    rho_new = max(rho_new, rho_floor);

    float p_new = p_val + dp * dt_small;
    if (isnan(p_new) || isinf(p_new) || p_new <= 0.0)
        p_new = p_floor;
    p_new = max(p_new, p_floor);

    rho_out[c] = rho_new;
    p_out[c]   = p_new;
}
