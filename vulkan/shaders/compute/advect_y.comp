// advect_y.comp
//
// GLSL compute shader implementing first-order upwind y-direction advection
// on a Cartesian grid.
//
// GPU equivalent of advect_scalar_1d_y_kernel_cartesian in
// src/advection/advection_cartesian.cpp.
//
// Each invocation processes one interior grid point (i,j,k).
// No periodic boundaries — straight j-1/j+1 indexing, no modulo.
// Boundary points in y (j=0, j=NTH-1) and z (k=0, k=NZ-1) are skipped.
// All i indices are processed (i=0..NR-1) since the CPU seeds boundary
// values via memcpy before dispatch.
//
// Data layout is row-major [nr][nth][nz].

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer SrcBuf { float src[];       };
layout(set = 0, binding = 1) readonly buffer VBuf   { float v_field[];   };
layout(set = 0, binding = 2) buffer DstBuf          { float dst[];       };

layout(push_constant) uniform PushConstants {
    int   nr;
    int   nth;
    int   nz;
    float dy;
    float dt;
    float padding[3];
};

void main() {
    uint gid = gl_GlobalInvocationID.x;

    // Interior: all i, j=1..nth-2, k=1..nz-2
    int interior_nth = nth - 2;
    int interior_nz  = nz - 2;
    uint total_interior = uint(nr) * uint(interior_nth) * uint(interior_nz);

    if (gid >= total_interior) {
        return;
    }

    int k_interior = int(gid % uint(interior_nz));
    uint ij = gid / uint(interior_nz);
    int j_interior = int(ij % uint(interior_nth));
    int i = int(ij / uint(interior_nth));

    int j = j_interior + 1;
    int k = k_interior + 1;

    uint c  = uint((i * nth + j) * nz + k);
    uint jm = uint((i * nth + (j - 1)) * nz + k);
    uint jp = uint((i * nth + (j + 1)) * nz + k);

    float v_val = v_field[c];
    float q_c = src[c];
    float dq_dy = 0.0;

    if (v_val > 0.0) {
        dq_dy = (q_c - src[jm]) / dy;
    } else if (v_val < 0.0) {
        dq_dy = (src[jp] - q_c) / dy;
    }

    // Straight Cartesian: no 1/r factor (unlike the cylindrical azimuthal shader)
    dst[c] = q_c - dt * v_val * dq_dy;
}
