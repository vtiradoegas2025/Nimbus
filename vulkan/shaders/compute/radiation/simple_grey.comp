#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4466], 4461, 32);
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4467], 4462, 32);
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer B0
{
    float input_values[];
};
layout(set = 0, binding = 1) buffer B1
{
    float output_values[];
};
layout(push_constant) uniform PushConstants
{
    int columns;
    int layers;
    int longwave;
    int shortwave;
    int water;
    int padding0;
    int padding1;
    int padding2;
};
#include "../microphysics/compensated_fma.glsl"
vec2 param(int c, int f)
{
    int n = c * (34 + 14 * (layers + 1)) + 2 * f;
    return vec2(input_values[n], input_values[n + 1]);
}
vec2 state(int c, int k, int f)
{
    int n = c * (34 + 14 * (layers + 1)) + 34 + 14 * k + 2 * f;
    return vec2(input_values[n], input_values[n + 1]);
}
vec2 output_at(int c, int k, int f)
{
    int n = (c * (layers + 1) + k) * 18 + 2 * f;
    return vec2(output_values[n], output_values[n + 1]);
}
void put(int c, int k, int f, vec2 v)
{
    int n                = (c * (layers + 1) + k) * 18 + 2 * f;
    output_values[n]     = v.x;
    output_values[n + 1] = v.y;
}
vec2 attenuation(vec2 x)
{
    return x.x > 80 ? vec2(0) : df_exp(-x);
}
vec2 power(vec2 x, vec2 exponent)
{
    return x.x == 0 && x.y == 0 ? vec2(0) : df_exp(df_mul(exponent, df_log(x)));
}
vec2 blackbody(vec2 temperature, vec2 sigma)
{
    vec2 squared = df_mul(temperature, temperature);
    return df_mul(sigma, df_mul(squared, squared));
}
vec2 tau(int c, int k, bool lw)
{
    int  t = lw ? 5 : 7, e = lw ? 6 : 8;
    vec2 lower  = power(df_div(state(c, k, 1), vec2(100000, 0)), param(c, e));
    vec2 upper  = power(df_div(state(c, k + 1, 1), vec2(100000, 0)), param(c, e));
    vec2 result = df_mul(param(c, t), df_sub(lower, upper));
    if (water != 0)
    {
        int  first = lw ? 11 : 14;
        vec2 absorber =
            df_add(df_add(df_mul(param(c, first), state(c, k, 4)), df_mul(param(c, first + 1), state(c, k, 5))),
                   df_mul(param(c, first + 2), state(c, k, 6)));
        result = df_add(result, df_mul(df_mul(state(c, k, 2), state(c, k, 3)), absorber));
    }
    return result;
}
vec2 diffuse_transmission(vec2 x)
{
    if (x.x == 0 && x.y == 0)
        return vec2(1, 0);
    if (x.x > 80)
        return vec2(0);
    vec2 exponential = attenuation(x);
    if (x.x <= 1)
    {
        vec2 sum = df_sub(vec2(-0.5772156715393066, 6.637773885e-9), df_log(x)), term = vec2(1, 0);
        for (int k = 1; k <= 256; ++k)
        {
            term           = df_mul(term, df_div(-x, vec2(float(k), 0)));
            vec2 increment = df_div(-term, vec2(float(k), 0));
            sum            = df_add(sum, increment);
            if (abs(increment.x) + abs(increment.y) <= 1e-13 * max(1.0, abs(sum.x)))
            {
                vec2 e2 = df_sub(exponential, df_mul(x, sum));
                return df_sub(exponential, df_mul(x, e2));
            }
        }
    }
    else
    {
        vec2 b = df_add(x, vec2(3, 0)), c = vec2(1e30, 0), d = df_div(vec2(1, 0), b), fraction = d;
        for (int k = 1; k <= 256; ++k)
        {
            vec2 a = vec2(-float(k) * float(k + 2), 0);
            b      = df_add(b, vec2(2, 0));
            d      = df_add(df_mul(a, d), b);
            c      = df_add(b, df_div(a, c));
            if (abs(d.x) < 1e-30)
                d = vec2(1e-30, 0);
            if (abs(c.x) < 1e-30)
                c = vec2(1e-30, 0);
            d               = df_div(vec2(1, 0), d);
            vec2 multiplier = df_mul(c, d);
            fraction        = df_mul(fraction, multiplier);
            vec2 delta      = df_sub(multiplier, vec2(1, 0));
            if (abs(delta.x) + abs(delta.y) <= 1e-13)
                return df_mul(vec2(2, 0), df_mul(fraction, exponential));
        }
    }
    return vec2(uintBitsToFloat(0x7fc00000u));
}
void evaluate(uint gid)
{
    if (gid >= uint(columns))
        return;
    int c = int(gid);
    for (int k = 0; k <= layers; ++k)
        for (int f = 0; f < 9; ++f)
            put(c, k, f, vec2(0));
    if (longwave != 0)
    {
        vec2 down = vec2(0);
        for (int k = layers - 1; k >= 0; --k)
        {
            vec2 depth = tau(c, k, true), trans = attenuation(depth);
            if (depth.x < 0)
            {
                put(c, 0, 0, vec2(uintBitsToFloat(0x7fc00000u)));
                return;
            }
            vec2 emission = df_mul(blackbody(state(c, k, 0), param(c, 9)), df_sub(vec2(1, 0), trans));
            down          = df_add(df_mul(down, trans), emission);
            put(c, k, 1, down);
            put(c, k, 5, trans);
            put(c, k, 6, emission);
        }
        vec2 up = df_add(df_mul(param(c, 1), blackbody(param(c, 0), param(c, 9))),
                         df_mul(df_sub(vec2(1, 0), param(c, 1)), down));
        put(c, 0, 0, up);
        for (int k = 0; k < layers; ++k)
        {
            up = df_add(df_mul(up, output_at(c, k, 5)), output_at(c, k, 6));
            put(c, k + 1, 0, up);
        }
    }
    if (shortwave != 0 && param(c, 2).x > 0)
    {
        vec2 down = df_mul(param(c, 2), param(c, 3));
        put(c, layers, 3, down);
        for (int k = layers - 1; k >= 0; --k)
        {
            vec2 depth = tau(c, k, false);
            if (depth.x < 0)
            {
                put(c, 0, 2, vec2(uintBitsToFloat(0x7fc00000u)));
                return;
            }
            down = df_mul(down, attenuation(df_div(depth, param(c, 2))));
            put(c, k, 3, down);
            put(c, k, 4, depth);
        }
        vec2 surface_up = df_mul(param(c, 4), down), cumulative = vec2(0);
        put(c, 0, 2, surface_up);
        for (int k = 0; k < layers; ++k)
        {
            cumulative = df_add(cumulative, output_at(c, k, 4));
            put(c, k + 1, 2, df_mul(surface_up, diffuse_transmission(cumulative)));
        }
    }
    for (int k = 0; k < layers; ++k)
    {
        vec2 lower_l  = df_sub(output_at(c, k, 0), output_at(c, k, 1)),
             upper_l  = df_sub(output_at(c, k + 1, 0), output_at(c, k + 1, 1));
        vec2 lower_s  = df_sub(output_at(c, k, 2), output_at(c, k, 3)),
             upper_s  = df_sub(output_at(c, k + 1, 2), output_at(c, k + 1, 3));
        vec2 capacity = df_mul(df_mul(state(c, k, 2), state(c, k, 3)), param(c, 10));
        vec2 heat_l = df_div(df_sub(lower_l, upper_l), capacity), heat_s = df_div(df_sub(lower_s, upper_s), capacity);
        put(c, k, 4, heat_l);
        put(c, k, 5, heat_s);
        put(c, k, 6, df_add(heat_l, heat_s));
    }
    put(c,
        0,
        7,
        df_sub(df_sub(output_at(c, 0, 0), output_at(c, 0, 1)),
               df_sub(output_at(c, layers, 0), output_at(c, layers, 1))));
    put(c,
        0,
        8,
        df_sub(df_sub(output_at(c, 0, 2), output_at(c, 0, 3)),
               df_sub(output_at(c, layers, 2), output_at(c, layers, 3))));
}
void main()
{
    evaluate(gl_GlobalInvocationID.x);
}
