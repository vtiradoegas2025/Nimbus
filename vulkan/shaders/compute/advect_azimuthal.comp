// advect_azimuthal.comp
//
// GLSL compute shader implementing first-order upwind azimuthal advection.
//
// GPU equivalent of advect_scalar_1d_theta_kernel in src/advection/advection.cpp.
//
// Each invocation processes one interior grid point (i,j,k).
// Periodic boundary conditions in theta via modulo arithmetic.
// Boundary points in r (i=0, i=NR-1) and z (k=0, k=NZ-1) are skipped.
//
// Data layout is row-major [nr][nth][nz].

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// SSBOs
layout(set = 0, binding = 0) readonly buffer SrcBuf {
    float src[];
};

layout(set = 0, binding = 1) readonly buffer VBuf {
    float v[];
};

layout(set = 0, binding = 2) buffer DstBuf {
    float dst[];
};

// Push constants
layout(push_constant) uniform PushConstants {
    int   nr;
    int   nth;
    int   nz;
    float dr;
    float dtheta;
    float dt;
    float padding[2]; // Pad to 32 bytes
};

void main() {
    uint gid = gl_GlobalInvocationID.x;

    int interior_nz = nz - 2;
    int interior_nr = nr - 2;
    uint total_interior = uint(interior_nr) * uint(nth) * uint(interior_nz);

    if (gid >= total_interior) {
        return;
    }

    // Map flat gid to (i_interior, j, k_interior)
    int k_interior = int(gid % uint(interior_nz));
    uint ij = gid / uint(interior_nz);
    int j = int(ij % uint(nth));
    int i_interior = int(ij / uint(nth));

    int i = i_interior + 1;
    int k = k_interior + 1;

    // Periodic theta neighbors
    int j_prev = (j - 1 + nth) % nth;
    int j_next = (j + 1) % nth;

    // Flat indices
    uint c  = uint((i * nth + j) * nz + k);
    uint jm = uint((i * nth + j_prev) * nz + k);
    uint jp = uint((i * nth + j_next) * nz + k);

    float v_val = v[c];
    float q_c = src[c];
    float dq_dtheta = 0.0;

    if (v_val > 0.0) {
        dq_dtheta = (q_c - src[jm]) / dtheta;
    } else if (v_val < 0.0) {
        dq_dtheta = (src[jp] - q_c) / dtheta;
    }

    // Cylindrical geometry: r = i * dr + epsilon
    float r = float(i) * dr + 1.0e-6;
    float dqdt = -(v_val / r) * dq_dtheta;

    dst[c] = q_c + dt * dqdt;
}
