// smagorinsky_coefficients.comp
//
// Smagorinsky eddy coefficients (GPU.md Phase 3.4): per-cell
// strain-rate magnitude -> nu_t = min((Cs*Delta)^2 * |S|, nu_t_max) and the
// eddy diffusivities K_theta = min(nu_t/Pr_t, K_max), K_q = min(nu_t/Sc_t,
// K_max). GPU equivalent of SmagorinskyScheme::compute_eddy_coefficients +
// eddy_viscosity::compute_directional_strain_sq_centered / compute_filter_width /
// compute_smagorinsky_viscosity / compute_eddy_diffusivities, for the
// flat-terrain, stability_correction == "none" configuration (the dispatch
// site guards both; the Richardson correction stays CPU).
//
// Stencil conventions mirrored exactly from the CPU:
//   - horizontal differences use CLAMPED indices with centered/one-sided
//     boundary fallback (strain is NOT periodic in j, unlike the
//     Laplacian pass);
//   - dz_prof[k] is scalar-cell thickness; adjacent-center differences use
//     0.5*(dz_prof[k] + dz_prof[k+1]), including on stretched grids;
//   - every spacing is validated as positive by the CPU dispatch contract,
//     so refined cells below one metre retain their physical dimensions.
//
// dz_prof / dzc_prof are 1D profiles broadcast across (i, j), computed on
// the host with the same grid_metric calls the CPU uses.
//
// Data layout: row-major [nx][ny][nz]. Index (i, j, k) = (i*ny + j)*nz + k.

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer UBuf    { float u_in[];     };
layout(set = 0, binding = 1) readonly buffer VBuf    { float v_in[];     };
layout(set = 0, binding = 2) readonly buffer WBuf    { float w_in[];     };
layout(set = 0, binding = 3) readonly buffer DzBuf   { float dz_prof[];  };
layout(set = 0, binding = 4) readonly buffer DzcBuf  { float dzc_prof[]; };

layout(set = 0, binding = 5) writeonly buffer NuBuf  { float nu_t[];    };
layout(set = 0, binding = 6) writeonly buffer KthBuf { float K_theta[]; };
layout(set = 0, binding = 7) writeonly buffer KqBuf  { float K_q[];     };

// Push constants (60 bytes; mirrors SmagorinskyCoefficientsPushConstants).
layout(push_constant) uniform PushConstants {
    int   nx;
    int   ny;
    int   nz;
    int   filter_mode;  // 0 = cubic_root (default), 1 = "dx" (sqrt(dx*dy))
    int   use_horizontal;
    int   use_vertical;
    float dx;
    float dy;
    float Cs;
    float Pr_t;
    float Sc_t;
    float nu_t_max;
    float K_max;
    int   periodic_y;  // j-topology (SCIENCE.md M16)
    int   periodic_x;
};

bool finite_f(float v) { return !isnan(v) && !isinf(v); }

float center_distance(int lower_k)
{
    return 0.5 * (dz_prof[lower_k] + dz_prof[lower_k + 1]);
}

// Mirrors the anonymous-namespace horiz_diff: centered in the interior,
// one-sided at the edges, with clamped neighbor loads.
float horiz_diff(float f_minus, float f_center, float f_plus,
                 float d, int idx, int n)
{
    if (idx > 0 && idx < n - 1) return (f_plus - f_minus) / (2.0 * d);
    if (idx == 0) return (f_plus - f_center) / d;
    return (f_center - f_minus) / d;
}

float vert_diff(float f_minus, float f_center, float f_plus,
                float dz_one_sided, float dz_centered, int k, int n)
{
    if (k > 0 && k < n - 1) return (f_plus - f_minus) / dz_centered;
    if (k == 0) return (f_plus - f_center) / dz_one_sided;
    return (f_center - f_minus) / dz_one_sided;
}

uint at(int i, int j, int k)
{
    return uint((i * ny + j) * nz + k);
}

int periodic_prev(int j)
{
    return (j <= 1) ? ny - 2 : min(j - 1, ny - 2);
}

int periodic_next(int j)
{
    return (j >= ny - 2) ? 1 : max(j + 1, 1);
}

int periodic_prev_x(int i)
{
    return (i <= 1) ? nx - 2 : min(i - 1, nx - 2);
}

int periodic_next_x(int i)
{
    return (i >= nx - 2) ? 1 : max(i + 1, 1);
}

void main()
{
    uint gid = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    uint total = uint(nx) * uint(ny) * uint(nz);
    if (gid >= total)
    {
        return;
    }

    int k = int(gid % uint(nz));
    uint ij = gid / uint(nz);
    int j = int(ij % uint(ny));
    int i = int(ij / uint(ny));
    uint c = gid;

    float dx_s  = dx;
    float dy_s  = dy;
    // dz/dzc are compact 1D [nz] profiles (GPU audit Phase 4.3).
    float dz_k  = dz_prof[k];

    // Staggered-consistent |S|^2 at the cell center (SCIENCE.md
    // M14; mirrors eddy_viscosity::compute_strain_sq_centered exactly):
    // diagonals from the cell's own faces, off-diagonals on the four
    // surrounding edges with their SQUARES averaged to the center.
    // u[i] is the x-face between centers i and i+1 (v, w analogous);
    // w below k=0 is the implicit ground face (zero), and the ground /
    // lid shear edges carry zero strain (free-slip, M19 convention).
    bool wrap_x = (periodic_x != 0);
    bool wrap_y = (periodic_y != 0);
    int jm = wrap_y ? periodic_prev(j) : max(j - 1, 0);
    int im = wrap_x ? periodic_prev_x(i) : max(i - 1, 0);

    float w_c  = w_in[c];
    float w_dn = (k > 0) ? w_in[at(i, j, k - 1)] : 0.0;

    float S11 = (u_in[c] - u_in[at(im, j, k)]) / dx_s;
    float S22 = (v_in[c] - v_in[at(i, jm, k)]) / dy_s;
    float S33 = (w_c - w_dn) / dz_k;

    // S12 on the xy-edge at (x-face ie, y-face je).
    float s12[4];
    {
        int ie[2]; ie[0] = im; ie[1] = i;
        int je[2]; je[0] = jm; je[1] = j;
        for (int a = 0; a < 2; ++a)
            for (int b = 0; b < 2; ++b)
            {
                int jj1 = wrap_y ? periodic_next(je[b]) : min(je[b] + 1, ny - 1);
                int ii1 = wrap_x ? periodic_next_x(ie[a])
                                 : min(ie[a] + 1, nx - 1);
                float dudy = (u_in[at(ie[a], jj1, k)]
                            - u_in[at(ie[a], je[b], k)]) / dy_s;
                float dvdx = (v_in[at(ii1, je[b], k)]
                            - v_in[at(ie[a], je[b], k)]) / dx_s;
                s12[a * 2 + b] = 0.5 * (dudy + dvdx);
            }
    }

    // xz edge gradients. Keep both derivatives separate: a directional
    // closure uses only the gradient transported in that direction, while
    // the 3-D closure uses the complete symmetric shear.
    vec2 xz[4];
    {
        int ie[2]; ie[0] = im; ie[1] = i;
        int ke[2]; ke[0] = k - 1; ke[1] = k;
        for (int a = 0; a < 2; ++a)
            for (int b = 0; b < 2; ++b)
            {
                if (ke[b] < 0 || ke[b] >= nz - 1)
                {
                    xz[a * 2 + b] = vec2(0.0);
                    continue;
                }
                int ii1 = wrap_x ? periodic_next_x(ie[a])
                                 : min(ie[a] + 1, nx - 1);
                float dudz = (u_in[at(ie[a], j, ke[b] + 1)]
                            - u_in[at(ie[a], j, ke[b])])
                            / center_distance(ke[b]);
                float dwdx = (w_in[at(ii1, j, ke[b])]
                            - w_in[at(ie[a], j, ke[b])]) / dx_s;
                xz[a * 2 + b] = vec2(dudz, dwdx);
            }
    }

    // yz edge gradients, retained separately for the same reason.
    vec2 yz[4];
    {
        int je[2]; je[0] = jm; je[1] = j;
        int ke[2]; ke[0] = k - 1; ke[1] = k;
        for (int a = 0; a < 2; ++a)
            for (int b = 0; b < 2; ++b)
            {
                if (ke[b] < 0 || ke[b] >= nz - 1)
                {
                    yz[a * 2 + b] = vec2(0.0);
                    continue;
                }
                int jj1 = wrap_y ? periodic_next(je[a]) : min(je[a] + 1, ny - 1);
                float dvdz = (v_in[at(i, je[a], ke[b] + 1)]
                            - v_in[at(i, je[a], ke[b])])
                            / center_distance(ke[b]);
                float dwdy = (w_in[at(i, jj1, ke[b])]
                            - w_in[at(i, je[a], ke[b])]) / dy_s;
                yz[a * 2 + b] = vec2(dvdz, dwdy);
            }
    }

    float S12_sq = 0.25 * (s12[0]*s12[0] + s12[1]*s12[1]
                         + s12[2]*s12[2] + s12[3]*s12[3]);
    float dudz_sq = 0.25 * (xz[0].x*xz[0].x + xz[1].x*xz[1].x
                          + xz[2].x*xz[2].x + xz[3].x*xz[3].x);
    float dwdx_sq = 0.25 * (xz[0].y*xz[0].y + xz[1].y*xz[1].y
                          + xz[2].y*xz[2].y + xz[3].y*xz[3].y);
    float dvdz_sq = 0.25 * (yz[0].x*yz[0].x + yz[1].x*yz[1].x
                          + yz[2].x*yz[2].x + yz[3].x*yz[3].x);
    float dwdy_sq = 0.25 * (yz[0].y*yz[0].y + yz[1].y*yz[1].y
                          + yz[2].y*yz[2].y + yz[3].y*yz[3].y);

    float strain_sq;
    if (use_horizontal != 0 && use_vertical == 0)
    {
        strain_sq = 2.0 * (S11*S11 + S22*S22) + 4.0*S12_sq
                  + dwdx_sq + dwdy_sq;
    }
    else if (use_horizontal == 0 && use_vertical != 0)
    {
        strain_sq = dudz_sq + dvdz_sq + 2.0*S33*S33;
    }
    else
    {
        float S13_sq = 0.25 * (
            0.25*(xz[0].x+xz[0].y)*(xz[0].x+xz[0].y)
          + 0.25*(xz[1].x+xz[1].y)*(xz[1].x+xz[1].y)
          + 0.25*(xz[2].x+xz[2].y)*(xz[2].x+xz[2].y)
          + 0.25*(xz[3].x+xz[3].y)*(xz[3].x+xz[3].y));
        float S23_sq = 0.25 * (
            0.25*(yz[0].x+yz[0].y)*(yz[0].x+yz[0].y)
          + 0.25*(yz[1].x+yz[1].y)*(yz[1].x+yz[1].y)
          + 0.25*(yz[2].x+yz[2].y)*(yz[2].x+yz[2].y)
          + 0.25*(yz[3].x+yz[3].y)*(yz[3].x+yz[3].y));
        strain_sq = 2.0 * (S11*S11 + S22*S22 + S33*S33)
                  + 4.0 * (S12_sq + S13_sq + S23_sq);
    }
    float strain_mag = (finite_f(strain_sq) && strain_sq > 0.0)
        ? sqrt(strain_sq) : 0.0;

    // Filter width (flat terrain: spacings are the uniform grid values).
    float Delta = (filter_mode == 1)
        ? sqrt(dx_s * dy_s)
        : pow(dx_s * dy_s * dz_k, 1.0 / 3.0);
    if (!finite_f(Delta) || Delta <= 0.0) Delta = 1.0;

    // stability_correction == "none" -> factor 1 (guarded at the dispatch).
    float nu = Cs * Cs * Delta * Delta * strain_mag;
    nu = max(nu, 0.0);
    if (!finite_f(nu)) nu = 0.0;
    nu = min(nu, nu_t_max);
    nu_t[c] = nu;

    float Kth = nu / Pr_t;
    float Kq  = nu / Sc_t;
    if (!finite_f(Kth) || Kth < 0.0) Kth = 0.0;
    if (!finite_f(Kq)  || Kq  < 0.0) Kq  = 0.0;
    K_theta[c] = min(Kth, K_max);
    K_q[c]     = min(Kq, K_max);
}
