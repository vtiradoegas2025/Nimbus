// Native Cartesian live-density finite-volume diffusion tendency.
//
// This is the float32 device realization of ExplicitDiffusionScheme. It
// computes
//
//   d(phi)/dt = (1/rho_phi) div(rho_phi K grad(phi))
//
// on the same A-grid cells or C-grid component control volumes as the CPU
// reference. Outer numerical fluxes are zero, closure/lid storage receives a
// zero tendency, and dz may vary by layer. The host performs the guarded state
// update and energy attribution; this kernel never advances `field` itself.

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer FieldBuf { float field[]; };
layout(set = 0, binding = 1) readonly buffer RhoBuf   { float rho[]; };
layout(set = 0, binding = 2) readonly buffer DzBuf    { float dz[]; };
layout(set = 0, binding = 3) writeonly buffer TendencyBuf {
    float tendency[];
};
layout(set = 0, binding = 4) readonly buffer VerticalKBuf {
    float vertical_K[];
};

// 64 bytes; mirrored by DiffusionPushConstants.
layout(push_constant) uniform PushConstants {
    int nx;
    int ny;
    int nz;
    int location;       // 0 scalar, 1 u-face, 2 v-face, 3 w-face
    int c_grid;
    int periodic_x;
    int periodic_y;
    int use_variable_K;
    float inv_dx2;
    float inv_dy2;
    float K_h;
    float K_v;
    float padding0;
    float padding1;
    float padding2;
    float padding3;
};

uint index_of(int i, int j, int k) {
    return uint((i * ny + j) * nz + k);
}

float scalar_density(int i, int j, int k) {
    return rho[index_of(i, j, k)];
}

float component_density(int i, int j, int k) {
    if (c_grid == 0 || location == 0) {
        return scalar_density(i, j, k);
    }
    if (location == 1) {
        int right = (periodic_x != 0 && i == nx - 2) ? 1 : i + 1;
        return 0.5 * (scalar_density(i, j, k) +
                      scalar_density(right, j, k));
    }
    if (location == 2) {
        int north = (periodic_y != 0 && j == ny - 2) ? 1 : j + 1;
        return 0.5 * (scalar_density(i, j, k) +
                      scalar_density(i, north, k));
    }
    float lower_dz = dz[k];
    float upper_dz = dz[k + 1];
    return (scalar_density(i, j, k) * lower_dz +
            scalar_density(i, j, k + 1) * upper_dz) /
           (lower_dz + upper_dz);
}

float cell_vertical_K(int i, int j, int k) {
    return use_variable_K != 0 ? vertical_K[index_of(i, j, k)] : K_v;
}

float component_transport(int i, int j, int k) {
    if (c_grid == 0 || location == 0) {
        return scalar_density(i, j, k) * cell_vertical_K(i, j, k);
    }
    if (location == 1) {
        int right = (periodic_x != 0 && i == nx - 2) ? 1 : i + 1;
        return 0.5 * (scalar_density(i, j, k) * cell_vertical_K(i, j, k) +
                      scalar_density(right, j, k) * cell_vertical_K(right, j, k));
    }
    if (location == 2) {
        int north = (periodic_y != 0 && j == ny - 2) ? 1 : j + 1;
        return 0.5 * (scalar_density(i, j, k) * cell_vertical_K(i, j, k) +
                      scalar_density(i, north, k) * cell_vertical_K(i, north, k));
    }
    return 0.5 * (scalar_density(i, j, k) * cell_vertical_K(i, j, k) +
                  scalar_density(i, j, k + 1) * cell_vertical_K(i, j, k + 1));
}

void main() {
    uint gid = gl_GlobalInvocationID.x +
        gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    uint total = uint(nx) * uint(ny) * uint(nz);
    if (gid >= total) return;

    int k = int(gid % uint(nz));
    uint ij = gid / uint(nz);
    int j = int(ij % uint(ny));
    int i = int(ij / uint(ny));

    // Default for all closure, boundary-normal, and lid storage.
    tendency[gid] = 0.0;

    int i_begin = 1;
    int i_end = nx - 1;
    int j_begin = 1;
    int j_end = ny - 1;
    int k_begin = (c_grid != 0) ? 0 : 1;
    int k_end = (c_grid != 0) ? nz : nz - 1;

    if (c_grid != 0 && location == 1) {
        i_end = (periodic_x != 0) ? nx - 1 : nx - 2;
        k_end = nz - 1;
    } else if (c_grid != 0 && location == 2) {
        j_end = (periodic_y != 0) ? ny - 1 : ny - 2;
        k_end = nz - 1;
    } else if (c_grid != 0 && location == 3) {
        k_end = nz - 1;
    }

    if (i < i_begin || i >= i_end || j < j_begin || j >= j_end ||
        k < k_begin || k >= k_end) return;

    float rho_c = component_density(i, j, k);
    float value = field[gid];
    float result = 0.0;

    if (K_v > 0.0 || use_variable_K != 0) {
        bool bottom_closed = (k == k_begin);
        bool top_closed = (k == k_end - 1);
        bool w_control = (c_grid != 0 && location == 3);
        float control_mass = w_control
            ? 0.5 * (scalar_density(i, j, k) * dz[k] +
                     scalar_density(i, j, k + 1) * dz[k + 1])
            : rho_c * dz[k];
        float bottom_flux = 0.0;
        float top_flux = 0.0;

        if (!bottom_closed) {
            float point_dz = w_control
                ? dz[k] : 0.5 * (dz[k - 1] + dz[k]);
            float transport = use_variable_K != 0
                ? (w_control
                    ? scalar_density(i, j, k) * cell_vertical_K(i, j, k)
                    : 0.5 * (component_transport(i, j, k - 1) +
                             component_transport(i, j, k)))
                : (w_control
                    ? K_v * scalar_density(i, j, k)
                    : 0.5 * K_v *
                        (component_density(i, j, k - 1) + rho_c));
            bottom_flux = transport *
                (value - field[index_of(i, j, k - 1)]) / point_dz;
        }
        if (!top_closed) {
            float point_dz = w_control
                ? dz[k + 1] : 0.5 * (dz[k] + dz[k + 1]);
            float transport = use_variable_K != 0
                ? (w_control
                    ? scalar_density(i, j, k + 1) *
                        cell_vertical_K(i, j, k + 1)
                    : 0.5 * (component_transport(i, j, k) +
                             component_transport(i, j, k + 1)))
                : (w_control
                    ? K_v * scalar_density(i, j, k + 1)
                    : 0.5 * K_v *
                        (rho_c + component_density(i, j, k + 1)));
            top_flux = transport *
                (field[index_of(i, j, k + 1)] - value) / point_dz;
        }
        result += (top_flux - bottom_flux) / control_mass;
    }

    if (K_h > 0.0) {
        bool west_closed = (i == i_begin && periodic_x == 0);
        bool east_closed = (i == i_end - 1 && periodic_x == 0);
        bool south_closed = (j == j_begin && periodic_y == 0);
        bool north_closed = (j == j_end - 1 && periodic_y == 0);
        int iw = (i == i_begin && periodic_x != 0) ? i_end - 1 : i - 1;
        int ie = (i == i_end - 1 && periodic_x != 0) ? i_begin : i + 1;
        int js = (j == j_begin && periodic_y != 0) ? j_end - 1 : j - 1;
        int jn = (j == j_end - 1 && periodic_y != 0) ? j_begin : j + 1;

        float x_div = 0.0;
        float y_div = 0.0;
        if (!west_closed) {
            float rho_w = 0.5 * (rho_c + component_density(iw, j, k));
            x_div -= rho_w *
                (value - field[index_of(iw, j, k)]) * inv_dx2;
        }
        if (!east_closed) {
            float rho_e = 0.5 * (rho_c + component_density(ie, j, k));
            x_div += rho_e *
                (field[index_of(ie, j, k)] - value) * inv_dx2;
        }
        if (!south_closed) {
            float rho_s = 0.5 * (rho_c + component_density(i, js, k));
            y_div -= rho_s *
                (value - field[index_of(i, js, k)]) * inv_dy2;
        }
        if (!north_closed) {
            float rho_n = 0.5 * (rho_c + component_density(i, jn, k));
            y_div += rho_n *
                (field[index_of(i, jn, k)] - value) * inv_dy2;
        }
        result += K_h * (x_div + y_div) / rho_c;
    }

    tendency[gid] = result;
}
