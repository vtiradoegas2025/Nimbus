// Independent downward fluxes accumulate from the physical bottom upward in CPU storage order.
#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer QrBuf
{
    float qr_in[];
};
layout(set = 0, binding = 1) readonly buffer QsBuf
{
    float qs_in[];
};
layout(set = 0, binding = 2) readonly buffer QgBuf
{
    float qg_in[];
};
layout(set = 0, binding = 3) readonly buffer QhBuf
{
    float qh_in[];
};
layout(set = 0, binding = 4) readonly buffer RhoDBuf
{
    float rho_d_b[];
};
layout(set = 0, binding = 5) readonly buffer LayerBuf
{
    float layer_thickness[];
};
layout(set = 0, binding = 6) buffer DQrBuf
{
    float dqr_dt[];
};
layout(set = 0, binding = 7) buffer DQsBuf
{
    float dqs_dt[];
};
layout(set = 0, binding = 8) buffer DQgBuf
{
    float dqg_dt[];
};
layout(set = 0, binding = 9) buffer DQhBuf
{
    float dqh_dt[];
};

// Push constants mirror LinSedimentationPushConstants.
layout(push_constant) uniform PushConstants
{
    int   nx;
    int   ny;
    int   nz;
    float dz_val;
    float vt_cap;     // 0.9 dz/dt CFL cap (corrected speeds)
    int   have_rho_d; // required by production; retained flag for ABI clarity
    int   have_layer_thickness;
    int   pad1;
    int   i_begin;
    int   i_end;
    int   j_begin;
    int   j_end;
    int   k_begin;
    int   k_end;
    int   pad_tail0;
    int   pad_tail1;
};

// LFO83 mass-weighted fall speeds over Marshall-Palmer distributions
// (mirrors fall_speeds.hpp - keep in sync).
const float PI_F             = 3.14159265;
const float G_GRAV           = 9.81;
const float RHO_WATER        = 1000.0;
const float N0_RAIN          = 8.0e6;
const float RHO_SNOW         = 100.0;
const float N0_SNOW          = 3.0e6;
const float RHO_GRAUPEL      = 400.0;
const float N0_GRAUPEL       = 4.0e5;
const float RHO_HAIL         = 913.0;
const float N0_HAIL          = 4.0e4;
const float RAIN_A           = 841.99667;
const float RAIN_B           = 0.8;
const float SNOW_C           = 4.83607122;
const float SNOW_D           = 0.25;
const float CD_DRAG          = 0.6;
const float GAMMA_4P8        = 17.837862;
const float GAMMA_4P25       = 8.2850847;
const float GAMMA_4P5        = 11.6317284;
const float MIN_Q_SED        = 1.0e-9;
const float FALLBACK_RHO_AIR = 1.2;

float mp_lambda(float q, float rho_air, float rho_x, float N0)
{
    return pow(PI_F * rho_x * N0 / (rho_air * q), 0.25);
}

// Wisner drag-balance speed (graupel/hail): air density explicit, so
// the altitude factor must NOT be applied on top.
float wisner_speed(float q, float rho_air, float rho_x, float N0)
{
    float lam  = mp_lambda(q, rho_air, rho_x, N0);
    float drag = sqrt(4.0 * G_GRAV * rho_x / (3.0 * CD_DRAG * rho_air));
    return (GAMMA_4P5 / 6.0) * drag / sqrt(lam);
}

void evaluate(uint col)
{
    uint total_columns = uint(nx) * uint(ny);
    if (col >= total_columns)
    {
        return;
    }

    int i = int(col) / ny, j = int(col) % ny;
    if (i < i_begin || i >= i_end || j < j_begin || j >= j_end)
        return;
    uint base = col * uint(nz);

    for (int k = k_begin; k < k_end; ++k)
    {
        uint  c        = base + uint(k);
        float donor_dz = dz_val, receiver_dz = dz_val;
        if (have_layer_thickness != 0)
        {
            donor_dz    = layer_thickness[c];
            receiver_dz = k > k_begin ? layer_thickness[c - 1u] : donor_dz;
        }

        // SCIENCE.md M11 (mirrors the CPU exactly): density-
        // corrected fall speed, CFL cap, receiver weighting.
        // Uniform branch (not a ternary): when the profile is absent the
        // bound buffer is a 1-float dummy, and OpSelect could still
        // evaluate the out-of-bounds read.
        float fall_factor = 1.0;
        float recv_weight = 1.0;
        float rho_air_k   = FALLBACK_RHO_AIR;
        if (have_rho_d != 0)
        {
            float rho_d_k  = rho_d_b[c];
            float rho_d_km = (k > k_begin) ? rho_d_b[c - 1u] : rho_d_k;
            fall_factor    = sqrt(FALLBACK_RHO_AIR / rho_d_k);
            recv_weight    = rho_d_k / rho_d_km;
            rho_air_k      = rho_d_k;
        }

        // Rain/snow carry the altitude factor; Wisner graupel/hail do not.
        float qr_val = qr_in[c];
        if (qr_val > MIN_Q_SED)
        {
            float lam      = mp_lambda(qr_val, rho_air_k, RHO_WATER, N0_RAIN);
            float Vt       = RAIN_A * GAMMA_4P8 / (6.0 * pow(lam, RAIN_B));
            Vt             = min(Vt * fall_factor, vt_cap);
            float sed_flux = Vt * qr_val;
            dqr_dt[c] -= sed_flux / donor_dz;
            if (k > k_begin)
                dqr_dt[c - 1u] += recv_weight * sed_flux / receiver_dz;
        }

        float qs_val = qs_in[c];
        if (qs_val > MIN_Q_SED)
        {
            float lam      = mp_lambda(qs_val, rho_air_k, RHO_SNOW, N0_SNOW);
            float Vt       = SNOW_C * GAMMA_4P25 / (6.0 * pow(lam, SNOW_D));
            Vt             = min(Vt * fall_factor, vt_cap);
            float sed_flux = Vt * qs_val;
            dqs_dt[c] -= sed_flux / donor_dz;
            if (k > k_begin)
                dqs_dt[c - 1u] += recv_weight * sed_flux / receiver_dz;
        }

        float qg_val = qg_in[c];
        if (qg_val > MIN_Q_SED)
        {
            float Vt       = min(wisner_speed(qg_val, rho_air_k, RHO_GRAUPEL, N0_GRAUPEL), vt_cap);
            float sed_flux = Vt * qg_val;
            dqg_dt[c] -= sed_flux / donor_dz;
            if (k > k_begin)
                dqg_dt[c - 1u] += recv_weight * sed_flux / receiver_dz;
        }

        float qh_val = qh_in[c];
        if (qh_val > MIN_Q_SED)
        {
            float Vt       = min(wisner_speed(qh_val, rho_air_k, RHO_HAIL, N0_HAIL), vt_cap);
            float sed_flux = Vt * qh_val;
            dqh_dt[c] -= sed_flux / donor_dz;
            if (k > k_begin)
                dqh_dt[c - 1u] += recv_weight * sed_flux / receiver_dz;
        }
    }
}

void main()
{
    evaluate(gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x);
}
