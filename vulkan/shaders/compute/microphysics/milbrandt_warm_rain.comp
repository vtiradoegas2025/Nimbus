#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4466], 4461, 32);
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4467], 4462, 32);
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer B0
{
    float s0[];
};
layout(set = 0, binding = 1) readonly buffer B1
{
    float s1[];
};
layout(set = 0, binding = 2) readonly buffer B2
{
    float s2[];
};
layout(set = 0, binding = 3) readonly buffer B3
{
    float s3[];
};
layout(set = 0, binding = 4) readonly buffer B4
{
    float s4[];
};
layout(set = 0, binding = 5) readonly buffer B5
{
    float s5[];
};
layout(set = 0, binding = 6) readonly buffer B6
{
    float s6[];
};
layout(set = 0, binding = 7) readonly buffer B7
{
    float s7[];
};
layout(set = 0, binding = 8) readonly buffer B8
{
    float r0[];
};
layout(set = 0, binding = 9) readonly buffer B9
{
    float r1[];
};
layout(set = 0, binding = 10) readonly buffer B10
{
    float r2[];
};
layout(set = 0, binding = 11) readonly buffer B11
{
    float r3[];
};
layout(set = 0, binding = 12) readonly buffer B12
{
    float r4[];
};
layout(set = 0, binding = 13) readonly buffer B13
{
    float r5[];
};
layout(set = 0, binding = 14) readonly buffer B14
{
    float coeff[];
};
layout(set = 0, binding = 15) writeonly buffer B15
{
    float o0[];
};
layout(set = 0, binding = 16) writeonly buffer B16
{
    float o1[];
};
layout(set = 0, binding = 17) writeonly buffer B17
{
    float o2[];
};
layout(set = 0, binding = 18) writeonly buffer B18
{
    float o3[];
};
layout(set = 0, binding = 19) writeonly buffer B19
{
    float o4[];
};
layout(set = 0, binding = 20) writeonly buffer B20
{
    float o5[];
};
layout(push_constant) uniform PushConstants
{
    int   nx;
    int   ny;
    int   nz;
    int   i_begin;
    int   i_end;
    int   j_begin;
    int   j_end;
    int   k_begin;
    int   k_end;
    float dt_high;
    float dt_low;
};
#include "thompson_compensated.glsl"
float df_value(vec2 x)
{
    return x.x + x.y;
}
vec2 df_positive(vec2 x)
{
    return x.x < 0.0 ? vec2(0) : x;
}
float power(float x, float exponent)
{
    if (x == 0.0)
        return 0.0;
    return df_value(df_exp(df_mul(df_log(vec2(x, 0)), vec2(exponent, 0))));
}
float cbrt(float x)
{
    if (x == 0.0)
        return 0.0;
    return df_value(df_exp(df_mul(df_log(vec2(x, 0)), vec2(0.3333333432674408, -9.9341074810688216e-9))));
}
#include "milbrandt_thermodynamics.glsl"
void evaluate(uint gid)
{
    if (gid >= uint(nx) * uint(ny) * uint(nz))
        return;
    int k = int(gid % uint(nz)), j = int(gid / uint(nz) % uint(ny)), i = int(gid / (uint(nz) * uint(ny)));
    o0[gid] = r0[gid];
    o1[gid] = r1[gid];
    o2[gid] = r2[gid];
    o3[gid] = r3[gid];
    o4[gid] = r4[gid];
    o5[gid] = r5[gid];
    if (i < i_begin || i >= i_end || j < j_begin || j >= j_end || k < k_begin || k >= k_end)
        return;
    vec2        step                 = vec2(dt_high, dt_low);
    float       dt                   = dt_high + dt_low;
    const float eps_q                = 1.0e-14;
    const float eps_n                = 1.0e-3; // volumetric, m-3
    const float sigma_threshold_m    = 15.0e-6;
    const float kk1                  = 3.03e3;
    const float kk2                  = 2.59e15;
    const float rain_hump_diameter_m = 82.0e-6;
    const float rain_max_diameter_m  = 5.0e-3;

    const float density       = s2[gid];
    const float pressure      = s1[gid];
    float       vapor         = s3[gid];
    float       cloud         = s4[gid];
    float       rain          = s5[gid];
    const float temperature_k = s0[gid];
    const float nc_old_mix    = s6[gid];
    const float nr_old_mix    = s7[gid];
    float       nc            = density * (nc_old_mix + dt * (r4[gid]));
    float       nr            = density * nr_old_mix;
    nc                        = max(0.0, nc);
    nr                        = max(0.0, nr);

    vec2  vapor_ds = vec2(vapor, 0), cloud_ds = vec2(cloud, 0), rain_ds = vec2(rain, 0);
    vec2  nc_initial = df_mul(vec2(density, 0), df_add(vec2(nc_old_mix, 0), df_mul(step, vec2(r4[gid], 0))));
    vec2  nr_initial = df_mul(vec2(density, 0), vec2(nr_old_mix, 0));
    vec2  nc_ds = nc_initial, nr_ds = nr_initial;
    float i_lambda_c          = 0.0;
    float i_lambda_c3         = 0.0;
    float i_lambda_c6         = 0.0;
    float cloud_mean_diameter = 0.0;
    float cloud_sigma         = 0.0;
    float liquid_water_scale  = 0.0;
    float autoconversion_tau  = 0.0;
    if (cloud > eps_q && nc > eps_n)
    {
        i_lambda_c                  = cbrt(density * cloud / nc * coeff[13]);
        i_lambda_c3                 = i_lambda_c * i_lambda_c * i_lambda_c;
        i_lambda_c6                 = i_lambda_c3 * i_lambda_c3;
        cloud_mean_diameter         = i_lambda_c * cbrt(coeff[7] / coeff[6]);
        const float variance_factor = max(0.0, coeff[8] / coeff[6] - (coeff[7] / coeff[6]) * (coeff[7] / coeff[6]));
        cloud_sigma                 = i_lambda_c * power(variance_factor, 1.0 / 6.0);
        liquid_water_scale =
            0.027 * density * cloud * (6.25e18 * cloud_sigma * cloud_sigma * cloud_sigma * cloud_mean_diameter - 0.4);
        if (cloud_sigma > sigma_threshold_m)
        {
            autoconversion_tau = 3.7 / (density * cloud * (0.5e6 * cloud_sigma - 7.5));
        }
    }

    float rain_mean_diameter = 0.0;
    float i_lambda_r         = 0.0;
    float i_lambda_r3        = 0.0;
    float i_lambda_r6        = 0.0;
    if (rain > eps_q && nr > eps_n)
    {
        rain_mean_diameter = cbrt(density * rain / (nr * coeff[1]));
        if (rain_mean_diameter > 3.0e-3)
        {
            const float excess = rain_mean_diameter - 3.0e-3;
            nr_ds              = df_mul(
                nr_ds,
                vec2(max(1.0 + 2.0e4 * excess * excess, power(rain_mean_diameter / rain_max_diameter_m, 3.0)), 0));
            nr                 = nr_ds.x + nr_ds.y;
            rain_mean_diameter = cbrt(density * rain / (nr * coeff[1]));
        }
        i_lambda_r  = cbrt(density * rain / nr * coeff[14]);
        i_lambda_r3 = i_lambda_r * i_lambda_r * i_lambda_r;
        i_lambda_r6 = i_lambda_r3 * i_lambda_r3;
    }

    float auto_mass_rate        = 0.0;
    float auto_number_rate      = 0.0;
    float cloud_self_collection = 0.0;
    float initial_rain_diameter = 0.0;
    if (cloud > eps_q && cloud_sigma > sigma_threshold_m && autoconversion_tau > 0.0)
    {
        auto_mass_rate                  = min(max(liquid_water_scale / autoconversion_tau, 0.0), cloud / dt);
        initial_rain_diameter           = max(83.0e-6, 12.6e-4 / (0.5e6 * cloud_sigma - 3.5));
        const float conversion_diameter = max(initial_rain_diameter, rain_mean_diameter);
        auto_number_rate                = auto_mass_rate * density / (coeff[1] * power(conversion_diameter, coeff[2]));
        cloud_self_collection = min(kk2 * (nc * i_lambda_c3) * (nc * i_lambda_c3) * coeff[8] / coeff[6], nc / dt);
    }

    float      accretion_mass_rate   = 0.0;
    float      accretion_number_rate = 0.0;
    float      rain_self_collection  = 0.0;
    const bool rain_present          = rain > eps_q && nr > eps_n;
    if (rain_present && (rain > 1.2 * max(liquid_water_scale, 0.0) / density ||
                         rain_mean_diameter > max(5.0e-6, initial_rain_diameter)))
    {
        if (cloud > eps_q && liquid_water_scale > 0.0)
        {
            if (rain_mean_diameter >= 100.0e-6)
            {
                accretion_number_rate =
                    kk1 * nc * nr * (coeff[7] / coeff[6] * i_lambda_c3 + coeff[11] / coeff[10] * i_lambda_r3);
                accretion_mass_rate =
                    coeff[1] / density * kk1 * nc * nr * i_lambda_c3 *
                    (coeff[8] / coeff[6] * i_lambda_c3 + coeff[7] / coeff[6] * coeff[11] / coeff[10] * i_lambda_r3);
            }
            else
            {
                accretion_number_rate = kk2 * ((nc * i_lambda_c3) * (nr * i_lambda_c3) * coeff[8] / coeff[6] +
                                               (nc * i_lambda_r3) * (nr * i_lambda_r3) * coeff[12] / coeff[10]);
                accretion_mass_rate =
                    coeff[1] / density * kk2 * (nc * i_lambda_c3) * nr *
                    (coeff[9] / coeff[10] * i_lambda_c6 + coeff[7] / coeff[6] * coeff[12] / coeff[10] * i_lambda_r6);
            }
            accretion_number_rate = min(accretion_number_rate, nc / dt);
            accretion_mass_rate   = min(accretion_mass_rate, cloud / dt);
        }

        const float nr_squared      = nr * nr;
        rain_self_collection        = rain_mean_diameter >= 100.0e-6
                                          ? kk1 * nr_squared * coeff[11] / coeff[10] * i_lambda_r3
                                          : kk2 * (nr * i_lambda_r3) * (nr * i_lambda_r3) * coeff[12] / coeff[10];
        float collection_efficiency = 1.0;
        if (i_lambda_r > 300.0e-6)
        {
            collection_efficiency = 2.0 - exp(2300.0 * (i_lambda_r - 300.0e-6));
        }
        rain_self_collection = min(collection_efficiency * rain_self_collection, 0.5 * nr / dt);
    }

    const float cloud_sink = (auto_mass_rate + accretion_mass_rate) * dt;
    if (cloud_sink > cloud && cloud_sink > 0.0)
    {
        const float scale = cloud / cloud_sink;
        auto_mass_rate *= scale;
        accretion_mass_rate *= scale;
        accretion_number_rate *= scale;
    }

    cloud_ds = df_positive(df_add(cloud_ds, df_mul(step, vec2(-(auto_mass_rate + accretion_mass_rate), 0))));
    cloud    = cloud_ds.x + cloud_ds.y;
    rain_ds  = df_positive(df_add(rain_ds, df_mul(step, vec2((auto_mass_rate + accretion_mass_rate), 0))));
    rain     = rain_ds.x + rain_ds.y;
    nc_ds    = df_positive(df_add(nc_ds, df_mul(step, vec2(-(accretion_number_rate + cloud_self_collection), 0))));
    nc       = nc_ds.x + nc_ds.y;
    nr_ds    = df_positive(df_add(nr_ds, df_mul(step, vec2((auto_number_rate - rain_self_collection), 0))));
    nr       = nr_ds.x + nr_ds.y;

    if (rain > eps_q && nr > eps_n)
    {
        rain_mean_diameter = cbrt(density * rain / (nr * coeff[1]));
        if (rain_mean_diameter > 3.0e-3)
        {
            const float excess = rain_mean_diameter - 3.0e-3;
            nr_ds              = df_mul(
                nr_ds,
                vec2(max(1.0 + 2.0e4 * excess * excess, power(rain_mean_diameter / rain_max_diameter_m, 3.0)), 0));
            nr = nr_ds.x + nr_ds.y;
        }
        else if (rain_mean_diameter < rain_hump_diameter_m)
        {
            cloud_ds = df_add(cloud_ds, rain_ds);
            cloud    = cloud_ds.x + cloud_ds.y;
            nc_ds    = df_add(nc_ds, nr_ds);
            nc       = nc_ds.x + nc_ds.y;
            rain     = 0.0;
            rain_ds  = vec2(0);
            nr       = 0.0;
            nr_ds    = vec2(0);
        }
    }
    else
    {
        rain    = 0.0;
        rain_ds = vec2(0);
        nr      = 0.0;
        nr_ds   = vec2(0);
    }

    // Diffusion/ventilation-limited rain evaporation. This is the
    // MY operational equation, including latent-cooling feedback.
    const vec2  qsat_ds            = qsat_water(temperature_k, pressure);
    const float qsat               = df_value(qsat_ds);
    const vec2  vapor_deficit      = df_sub(vec2(vapor, 0), qsat_ds);
    float       temperature_change = 0.0;
    if (vapor_deficit.x < 0.0 && rain > eps_q && nr > eps_n)
    {
        const float saturation_ratio    = df_value(df_div(vapor_deficit, qsat_ds));
        const float tc                  = temperature_k - 273.15;
        const float vapor_diffusivity   = max(1.62e-5, 2.2157e-5 + 0.0155e-5 * tc) * 1.0e5 / pressure;
        const float dynamic_viscosity   = max(1.51e-5, 1.7153e-5 + 0.0050e-5 * tc);
        const float conductivity        = max(2.07e-2, 2.3971e-2 + 0.0078e-2 * tc);
        const float kinematic_viscosity = dynamic_viscosity / density;
        const float schmidt_third       = cbrt(kinematic_viscosity / vapor_diffusivity);
        i_lambda_r                      = cbrt(density * rain / nr * coeff[14]);
        const float lambda_r            = 1.0 / i_lambda_r;
        const float intercept           = nr * power(lambda_r, 1.0 + coeff[0]) / coeff[10];
        const float density_factor      = sqrt(1.225 / density);
        const float ventilation         = 0.78 * coeff[15] * power(i_lambda_r, 2.0 + coeff[0]) +
                                          0.30 * schmidt_third * sqrt(density_factor * coeff[3] / kinematic_viscosity) *
                                              coeff[16] * power(i_lambda_r, 2.5 + coeff[0] + 0.5 * coeff[4]);
        const float resistance = 2500000.0 * 2500000.0 / (conductivity * 461.5 * temperature_k * temperature_k) +
                                 1.0 / (density * qsat * vapor_diffusivity);
        const float evaporated = min(rain,
                                     max(0.0,
                                         -dt / density * 2.0 * 3.14159265358979323846 * saturation_ratio * intercept *
                                             ventilation / resistance));
        if (evaporated > 0.0)
        {
            const float rain_before = rain;
            vapor_ds                = df_add(vapor_ds, vec2(evaporated, 0));
            vapor                   = vapor_ds.x + vapor_ds.y;
            rain_ds                 = df_sub(rain_ds, vec2(evaporated, 0));
            rain                    = rain_ds.x + rain_ds.y;
            nr_ds                   = df_mul(nr_ds, df_div(rain_ds, df_add(rain_ds, vec2(evaporated, 0))));
            nr                      = nr_ds.x + nr_ds.y;
            temperature_change -= 2500000.0 / 1004.0 * evaporated;
        }
    }

    o0[gid] = df_value(df_add(vec2(r0[gid], 0), df_div(df_sub(cloud_ds, vec2(s4[gid], 0)), step)));
    o1[gid] = df_value(df_add(vec2(r1[gid], 0), df_div(df_sub(rain_ds, vec2(s5[gid], 0)), step)));
    o2[gid] = df_value(df_add(vec2(r2[gid], 0), df_div(df_sub(vapor_ds, vec2(s3[gid], 0)), step)));
    o3[gid] = r3[gid] + temperature_change / dt;
    o4[gid] = df_value(df_add(vec2(r4[gid], 0), df_div(df_sub(nc_ds, nc_initial), df_mul(vec2(density, 0), step))));
    o5[gid] = df_value(df_add(vec2(r5[gid], 0), df_div(df_sub(nr_ds, nr_initial), df_mul(vec2(density, 0), step))));
    if (nc_ds.x == 0.0 && nc_ds.y == 0.0)
        o4[gid] = -s6[gid] / dt;
}
void main()
{
    evaluate(gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x);
}
