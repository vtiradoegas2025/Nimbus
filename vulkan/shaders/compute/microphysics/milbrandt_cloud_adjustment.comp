#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_spirv_intrinsics : require
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4466], 4461, 32);
spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4467], 4462, 32);
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) readonly buffer B0
{
    float s0[];
};
layout(set = 0, binding = 1) readonly buffer B1
{
    float s1[];
};
layout(set = 0, binding = 2) readonly buffer B2
{
    float s2[];
};
layout(set = 0, binding = 3) readonly buffer B3
{
    float s3[];
};
layout(set = 0, binding = 4) readonly buffer B4
{
    float s4[];
};
layout(set = 0, binding = 5) readonly buffer B5
{
    float s5[];
};
layout(set = 0, binding = 6) readonly buffer B6
{
    float s6[];
};
layout(set = 0, binding = 7) writeonly buffer B7
{
    float o0[];
};
layout(set = 0, binding = 8) writeonly buffer B8
{
    float o1[];
};
layout(set = 0, binding = 9) writeonly buffer B9
{
    float o2[];
};
layout(set = 0, binding = 10) writeonly buffer B10
{
    float o3[];
};
layout(set = 0, binding = 11) writeonly buffer B11
{
    float o4[];
};
layout(set = 0, binding = 12) writeonly buffer B12
{
    float o5[];
};
layout(set = 0, binding = 13) writeonly buffer B13
{
    float o6[];
};
layout(push_constant) uniform PushConstants
{
    int   nx;
    int   ny;
    int   nz;
    int   i_begin;
    int   i_end;
    int   j_begin;
    int   j_end;
    int   k_begin;
    int   k_end;
    int   face_staggered_velocity;
    float dt_high;
    float dt_low;
};
#include "thompson_compensated.glsl"
#include "liquid_adjustment.glsl"
vec2 polynomial(vec2 x, vec2 a, vec2 b, vec2 c, vec2 d, vec2 e)
{
    return df_add(df_mul(df_add(df_mul(df_add(df_mul(df_add(df_mul(a, x), b), x), c), x), d), x), e);
}
vec2 activated(vec2 w, float temperature, float pressure)
{
    if (!ml_greater(w, vec2(0.0010000000474974513, -4.7497451284572723e-11)))
        return vec2(2e8, 0);
    vec2 x = df_div(df_log(df_mul(w, vec2(100, 0))), vec2(2.3025851249694824, -3.1975436520781386e-08));
    vec2 t = df_sub(vec2(temperature, 0), vec2(273.14999389648438, 6.1035156022626325e-06));
    vec2 c = polynomial(t,
                        vec2(-2.1119999082941376e-09, -9.1705862511349757e-17),
                        vec2(3.9835999388060372e-08, 6.1193962772324912e-16),
                        vec2(2.3703000806563068e-06, -8.0656306828720548e-14),
                        vec2(-0.00014541999553330243, -4.466697573878714e-12),
                        vec2(-0.069799996912479401, -3.0875206002978217e-09));
    vec2 d = polynomial(t,
                        vec2(-4.210000170701278e-08, 1.7070127798724929e-15),
                        vec2(5.5744999372109305e-07, 6.2789069013512405e-15),
                        vec2(1.8459999409969896e-05, 5.9003010336182611e-13),
                        vec2(0.00096078001661226153, -1.661226147961492e-11),
                        vec2(0.71200001239776611, -1.239776614703203e-08));
    vec2 e = polynomial(t,
                        vec2(1.4340000120682816e-07, -1.206828164580914e-15),
                        vec2(-1.6454999922643765e-06, -7.7356234702482271e-15),
                        vec2(-4.3333999201422557e-05, -7.9857744494839927e-13),
                        vec2(-0.0076720002107322216, 2.1073222160328253e-10),
                        vec2(1.0055999755859375, 2.441406254938272e-08));
    vec2 g = polynomial(x,
                        vec2(0.0042260000482201576, -4.8220157901346372e-11),
                        vec2(-0.005601199809461832, -1.9053816770892018e-10),
                        vec2(-0.087846003472805023, 3.4728050296584101e-09),
                        vec2(0.027434999123215675, 8.7678432569848752e-10),
                        vec2(0.99320000410079956, -4.1007995887909487e-09));
    vec2 h = polynomial(t,
                        vec2(5.811000125532928e-09, -1.2553292810668625e-16),
                        vec2(1.558900066811475e-07, -6.6811474955301388e-15),
                        vec2(-3.8622998545179144e-05, -1.4548208557979558e-12),
                        vec2(0.0014470999594777822, 4.0522217742769429e-11),
                        vec2(0.14959999918937683, 8.1062317969227138e-10));
    vec2 p = df_mul(vec2(pressure, 0), vec2(0.0099999997764825821, 2.2351741811588166e-10));
    vec2 f = df_add(df_sub(df_mul(vec2(1.3400000398178236e-06, -3.9817823475177846e-14), df_mul(p, p)),
                           df_mul(vec2(0.0035113999620079994, 3.7992000604530896e-11), p)),
                    vec2(1.9452999830245972, 1.6975402861163502e-08));
    vec2 y = df_add(df_add(df_add(df_mul(c, df_mul(x, x)), df_mul(d, x)), e), df_mul(df_mul(f, g), h));
    if (y.x < 0.0)
        y = vec2(0);
    return df_mul(df_exp(df_mul(y, vec2(2.3025851249694824, -3.1975436520781386e-08))), vec2(1e6, 0));
}
void evaluate(uint gid)
{
    if (gid >= uint(nx) * uint(ny) * uint(nz))
        return;
    int k = int(gid % uint(nz)), j = int(gid / uint(nz) % uint(ny)), i = int(gid / (uint(nz) * uint(ny)));
    o0[gid] = s0[gid];
    o1[gid] = s3[gid];
    o2[gid] = s4[gid];
    o3[gid] = 0;
    o4[gid] = 0;
    o5[gid] = 0;
    o6[gid] = 0;
    if (i < i_begin || i >= i_end || j < j_begin || j >= j_end || k < k_begin || k >= k_end)
        return;
    vec2  step = vec2(dt_high, dt_low), latent = vec2(2490.039794921875, 4.5715575197391445e-05);
    vec2  transfer       = liquid_adjustment(s0[gid], s1[gid], s3[gid], s4[gid]);
    vec2  adjusted_T     = df_add(vec2(s0[gid], 0), df_mul(latent, transfer));
    vec2  adjusted_vapor = df_sub(vec2(s3[gid], 0), transfer);
    vec2  adjusted_cloud = df_add(vec2(s4[gid], 0), transfer);
    float stored_T       = value(adjusted_T);
    float stored_cloud   = max(0.0, value(adjusted_cloud));
    uint cloud_before = floatBitsToUint(s4[gid]) & 0x7fffffffu;
    if (cloud_before > 0u && cloud_before < 0x00800000u &&
        ((floatBitsToUint(transfer.x) | floatBitsToUint(transfer.y)) & 0x7fffffffu) == 0u)
    {
        bool evaporating = s0[gid] > 150.0 && ml_greater(milbrandt_qsat(vec2(s0[gid], 0), s1[gid]), vec2(s3[gid], 0));
        stored_cloud = evaporating ? 0.0 : s4[gid];
    }
    o0[gid]              = stored_T;
    o1[gid]              = max(0.0, value(adjusted_vapor));
    o2[gid]              = stored_cloud;
    vec2 cloud_rate      = df_div(transfer, step);
    o3[gid]              = value(df_mul(latent, cloud_rate));
    o4[gid]              = -value(cloud_rate);
    o5[gid]              = value(cloud_rate);
    // Metal comparisons may flush subnormal mass, while its particle count is still resolved.
    uint cloud_after  = floatBitsToUint(stored_cloud) & 0x7fffffffu;
    if (cloud_after > cloud_before)
    {
        vec2 velocity = vec2(s6[gid], 0);
        if (face_staggered_velocity != 0)
        {
            vec2 lower = vec2(0);
            if (k > 0)
            {
                lower = vec2(s6[gid - 1], 0);
            }
            else if (face_staggered_velocity == 2)
            {
                uint boundary = uint(nx) * uint(ny) * uint(nz) + 2u * (gid / uint(nz));
                lower = vec2(s6[boundary], s6[boundary + 1u]);
            }
            velocity = df_mul(vec2(.5, 0), df_add(velocity, lower));
        }
        vec2 new_number = df_div(activated(velocity, stored_T, s1[gid]), vec2(s2[gid], 0));
        vec2 increment  = df_sub(new_number, vec2(s5[gid], 0));
        if (ml_greater(increment, vec2(0)))
            o6[gid] = value(df_div(increment, step));
    }
    else if (cloud_after < cloud_before)
    {
        vec2 remaining = stored_cloud > 0.0
                             ? df_mul(vec2(s5[gid], 0), df_div(vec2(stored_cloud, 0), vec2(max(s4[gid], 1e-30), 0)))
                             : vec2(0);
        o6[gid]        = value(df_div(df_sub(remaining, vec2(s5[gid], 0)), step));
    }
}
void main()
{
    evaluate(gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x);
}
