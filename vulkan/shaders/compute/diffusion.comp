// diffusion.comp
//
// GLSL compute shader implementing cylindrical Laplacian diffusion.
//
// GPU equivalent of apply_diffusion_kernel in src/advection/advection.cpp.
//
// Each invocation processes one interior grid point (i,j,k).
// Periodic boundary conditions in theta via modulo arithmetic.
// Boundary points in r (i=0, i=NR-1) and z (k=0, k=NZ-1) are skipped.
//
// Data layout is row-major [nr][nth][nz].

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// SSBOs
layout(set = 0, binding = 0) readonly buffer SrcBuf {
    float src[];
};

layout(set = 0, binding = 1) buffer DstBuf {
    float dst[];
};

// Push constants (32 bytes)
layout(push_constant) uniform PushConstants {
    int   nr;
    int   nth;
    int   nz;
    float dr;
    float dtheta;
    float dz_val;
    float dt;
    float kappa;
};

void main() {
    uint gid = gl_GlobalInvocationID.x;

    int interior_nz = nz - 2;
    int interior_nr = nr - 2;
    uint total_interior = uint(interior_nr) * uint(nth) * uint(interior_nz);

    if (gid >= total_interior) {
        return;
    }

    // Map flat gid to (i_interior, j, k_interior)
    int k_interior = int(gid % uint(interior_nz));
    uint ij = gid / uint(interior_nz);
    int j = int(ij % uint(nth));
    int i_interior = int(ij / uint(nth));

    int i = i_interior + 1;
    int k = k_interior + 1;

    // Periodic theta neighbors
    int j_prev = (j - 1 + nth) % nth;
    int j_next = (j + 1) % nth;

    // Flat indices
    uint c  = uint((i * nth + j) * nz + k);
    uint im = uint(((i - 1) * nth + j) * nz + k);
    uint ip = uint(((i + 1) * nth + j) * nz + k);
    uint jm = uint((i * nth + j_prev) * nz + k);
    uint jp = uint((i * nth + j_next) * nz + k);
    uint km = uint((i * nth + j) * nz + (k - 1));
    uint kp = uint((i * nth + j) * nz + (k + 1));

    float q = src[c];

    float inv_dr2 = 1.0 / (dr * dr);
    float inv_dz2 = 1.0 / (dz_val * dz_val);

    // Cylindrical geometry: r = i * dr + epsilon
    float r = float(i) * dr + 1.0e-6;
    float inv_r2_dtheta2 = 1.0 / (r * r * dtheta * dtheta);

    float lap = (src[ip] - 2.0 * q + src[im]) * inv_dr2 +
                (src[kp] - 2.0 * q + src[km]) * inv_dz2 +
                (src[jp] - 2.0 * q + src[jm]) * inv_r2_dtheta2;

    dst[c] = q + dt * kappa * lap;
}
