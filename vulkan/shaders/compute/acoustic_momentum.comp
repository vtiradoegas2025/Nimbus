// acoustic_momentum.comp
//
// Fused acoustic momentum substep: pressure gradient -> u/v/w integration.
//
// GPU equivalent of SupercellScheme::compute_fast_momentum_tendencies
// followed by the integration loop in apply_fast_momentum (dynamics.cpp).
//
// Each invocation processes one grid point. Interior points compute the
// pressure gradient via centered finite differences; boundary points
// apply boundary conditions (antisymmetric u at r faces, symmetric
// v/w/rho/p; zero-gradient at z faces).
//
// Ping-pong design: reads rho/p from the UPDATED set (output of
// acoustic_pressure), reads u/v/w from the CURRENT set, writes
// updated u/v/w to the output set.
//
// Data layout is row-major [nr][nth][nz]. Theta is periodic.

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Input: updated rho, p (from pressure substep output)
layout(set = 0, binding = 0) readonly buffer RhoInBuf { float rho_in[]; };
layout(set = 0, binding = 1) readonly buffer PInBuf   { float p_in[];   };

// Input: current u, v, w (from previous substep)
layout(set = 0, binding = 2) readonly buffer UInBuf   { float u_in[];   };
layout(set = 0, binding = 3) readonly buffer VInBuf   { float v_in[];   };
layout(set = 0, binding = 4) readonly buffer WInBuf   { float w_in[];   };

// Output: updated u, v, w after integration
layout(set = 0, binding = 5) writeonly buffer UOutBuf { float u_out[]; };
layout(set = 0, binding = 6) writeonly buffer VOutBuf { float v_out[]; };
layout(set = 0, binding = 7) writeonly buffer WOutBuf { float w_out[]; };

// Push constants (40 bytes)
layout(push_constant) uniform PushConstants {
    int   nr;
    int   nth;
    int   nz;
    float dr;
    float dtheta;
    float dz_val;
    float dt_small;
    float wind_clamp_h;  // max horizontal wind magnitude (m/s)
    float wind_clamp_v;  // max vertical wind magnitude (m/s)
    float padding;
};

const float EPS = 1.0e-8;
const float RHO_MIN = 1.0e-6;

float sanitize(float val) {
    return (isnan(val) || isinf(val)) ? 0.0 : val;
}

float clamp_h(float val) {
    return clamp(val, -wind_clamp_h, wind_clamp_h);
}

float clamp_v(float val) {
    return clamp(val, -wind_clamp_v, wind_clamp_v);
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint total = uint(nr) * uint(nth) * uint(nz);
    if (gid >= total) return;

    // Map flat gid to (i, j, k)
    int k = int(gid % uint(nz));
    uint ij = gid / uint(nz);
    int j = int(ij % uint(nth));
    int i = int(ij / uint(nth));

    uint c = gid;

    bool is_r_boundary = (i == 0 || i == nr - 1);
    bool is_z_boundary = (k == 0 || k == nz - 1);
    bool is_boundary = is_r_boundary || is_z_boundary;

    if (is_boundary) {
        // Acoustic BCs for momentum fields
        if (is_r_boundary) {
            // Radial faces: antisymmetric u, symmetric v/w
            int i_src = (i == 0) ? 1 : nr - 2;
            uint src_idx = uint((i_src * nth + j) * nz + k);
            u_out[c] = -u_in[src_idx];              // antisymmetric
            v_out[c] =  v_in[src_idx];              // symmetric
            w_out[c] =  w_in[src_idx];              // symmetric
        } else {
            // z faces: zero-gradient
            int k_src = (k == 0) ? 1 : nz - 2;
            uint src_idx = uint((i * nth + j) * nz + k_src);
            u_out[c] = u_in[src_idx];
            v_out[c] = v_in[src_idx];
            w_out[c] = w_in[src_idx];
        }
        return;
    }

    // Interior: compute pressure gradient
    float r = float(i) * dr + EPS;

    int j_prev = (j - 1 + nth) % nth;
    int j_next = (j + 1) % nth;

    uint ip = uint(((i + 1) * nth + j) * nz + k);
    uint im = uint(((i - 1) * nth + j) * nz + k);
    uint jp = uint((i * nth + j_next) * nz + k);
    uint jm = uint((i * nth + j_prev) * nz + k);
    uint kp = uint((i * nth + j) * nz + (k + 1));
    uint km = uint((i * nth + j) * nz + (k - 1));

    float inv_2dr     = 1.0 / (2.0 * dr);
    float inv_2dtheta = 1.0 / (2.0 * dtheta);
    float inv_2dz     = 1.0 / (2.0 * dz_val);

    // Pressure gradients (using UPDATED p from pressure substep)
    float dp_dr  = (p_in[ip] - p_in[im]) * inv_2dr;
    float dp_dth = (p_in[jp] - p_in[jm]) * inv_2dtheta;
    float dp_dz  = (p_in[kp] - p_in[km]) * inv_2dz;

    float rho_val = rho_in[c];
    float rho_safe = (rho_val > RHO_MIN && !isinf(rho_val)) ? rho_val : 1.0;

    // Momentum tendencies: -grad(p) / rho
    float du = sanitize(-dp_dr / rho_safe);
    float dv = sanitize(-dp_dth / (rho_safe * r));
    float dw = sanitize(-dp_dz / rho_safe);

    // Integrate and clamp
    u_out[c] = clamp_h(u_in[c] + du * dt_small);
    v_out[c] = clamp_h(v_in[c] + dv * dt_small);
    w_out[c] = clamp_v(w_in[c] + dw * dt_small);
}
