# EditorConfig (https://editorconfig.org) - ModularityAudit finding 9.
# Mirrors .clang-format (LLVM base, 4-space indent, 120-column limit) for the
# many editors that apply EditorConfig but do not run clang-format on the fly.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cc,cxx,cpp,h,hpp}]
indent_size = 4
max_line_length = 120

[*.{yaml,yml,json}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab
